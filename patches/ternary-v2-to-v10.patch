+
+// v7 launcher: 32 rows x 128 tokens per CTA, two 16-row groups per warp sharing the activation
+// registers, which divides the activation L2 traffic (and its stall) by two.
+inline void launch_pq2_mma_v7(const std::uint8_t* codes, const std::uint8_t* scales,
+                              const __nv_bfloat16* x, __nv_bfloat16* out,
+                              std::int32_t rows, std::int32_t groups_per_row, std::int32_t tokens,
+                              std::int64_t x_row_stride, std::int64_t out_row_stride,
+                              cudaStream_t stream) {
+    const dim3 grid((rows + kV7Rows - 1) / kV7Rows, (tokens + kV4Cols - 1) / kV4Cols, 1);
+    ternary_pq2_mma_v7_kernel<<<grid, kV4Warps * 32, 0, stream>>>(
+        codes, scales, x, out, rows, groups_per_row, tokens, x_row_stride, out_row_stride);
+}
+#endif  // NINFER_TERNARY_V7_C_CUH
diff --git a/src/ops/linear/ternary/v8_b.cuh b/src/ops/linear/ternary/v8_b.cuh
new file mode 100644
index 0000000..8d7f5b3
--- /dev/null
+++ b/src/ops/linear/ternary/v8_b.cuh
@@ -0,0 +1,183 @@
+#ifndef NINFER_TERNARY_V8_B_CUH
+#define NINFER_TERNARY_V8_B_CUH
+// v8 = v7 + the f16 mma with a split accumulator. Measured on this card (bench/mb_peak.cu):
+// mma m16n8k16 with an f32 accumulator tops out at 56 TFLOPS, the f16/f16 form at 111.6 TFLOPS, so
+// once v7 pushed the kernel into the compute-bound regime the accumulator choice is worth ~2x. bf16
+// has no f16-accumulate mma, so the operands have to be f16: the ternary weights are +-s with s an
+// f16 scale, so the decoded A is exact, and the activations are O(1) rms-norm outputs that convert
+// without range trouble. Accumulating a whole 128-element quantization group in f16 and promoting
+// into f32 costs ~1 instruction per mma and measured 1.5e-3 relative L2 error in the microbench.
+// The includer supplies v4_a.cuh and ternary_mma_v2.cuh.
+#include <cuda_fp16.h>
+#include <cuda_pipeline.h>
+
+constexpr int kV8RowGroups = 4;                        // 16-row mma row groups per warp
+constexpr int kV8Rows      = kV4Rows * kV8RowGroups;   // 64 rows per CTA
+
+__device__ __forceinline__ std::uint32_t v8_pair(std::uint32_t byte, int half, float s) {
+    const int shift = half * 4;
+    const float f0 = static_cast<float>(static_cast<int>((byte >> shift) & 3u) - 1) * s;
+    const float f1 = static_cast<float>(static_cast<int>((byte >> (shift + 2)) & 3u) - 1) * s;
+    const __half2 h = __floats2half2_rn(f0, f1);
+    return *reinterpret_cast<const std::uint32_t*>(&h);
+}
+
+__device__ __forceinline__ std::uint32_t v8_bf2f16(std::uint32_t b) {
+    const float2 f = __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(&b));
+    const __half2 h = __float22half2_rn(f);
+    return *reinterpret_cast<const std::uint32_t*>(&h);
+}
+
+__device__ __forceinline__ void v8_mma_f16(std::uint32_t a0, std::uint32_t a1, std::uint32_t a2,
+                                           std::uint32_t a3, std::uint32_t b0, std::uint32_t b1,
+                                           std::uint32_t* c) {
+    asm volatile(
+        "mma.sync.aligned.m16n8k16.row.col.f16.f16.f16.f16 "
+        "{%0,%1},{%2,%3,%4,%5},{%6,%7},{%0,%1};\n"
+        : "+r"(c[0]), "+r"(c[1])
+        : "r"(a0), "r"(a1), "r"(a2), "r"(a3), "r"(b0), "r"(b1));
+}
+
+// promote one group's f16 partials into the f32 accumulators, then clear them for the next group
+__device__ __forceinline__ void v8_promote(const std::uint32_t* c16, float* c32) {
+    const __half2 lo = *reinterpret_cast<const __half2*>(&c16[0]);
+    const __half2 hi = *reinterpret_cast<const __half2*>(&c16[1]);
+    c32[0] += __low2float(lo);
+    c32[1] += __high2float(lo);
+    c32[2] += __low2float(hi);
+    c32[3] += __high2float(hi);
+}
+
+__global__ __launch_bounds__(kV4Warps * 32) void ternary_pq2_mma_v8_kernel(
+        const std::uint8_t* __restrict__ codes,
+        const std::uint8_t* __restrict__ scales,
+        const __nv_bfloat16* __restrict__ x,
+        __nv_bfloat16* __restrict__ dst,
+        int rows, int groups_per_row, int tokens, int x_row_stride, int out_row_stride) {
+    __shared__ __half slab[kV8RowGroups][kV4Rows * kV4SlabStride];
+    __shared__ std::uint8_t raw[kV8RowGroups][2][kV4Rows * 32];
+
+    const int tid = threadIdx.x;
+    const int warp = tid >> 5;
+    const int lane = tid & 31;
+    const int r0 = lane >> 2;
+    const int cpar = lane & 3;
+    const int row_base = blockIdx.x * kV8Rows;
+    const int tok_base = blockIdx.y * kV4Cols;
+    const int last_row = (rows > 0) ? (rows - 1) : 0;
+    const int last_tok = (tokens > 0) ? (tokens - 1) : 0;
+    const int srow = tid >> 3;
+    const int soff = (tid & 7) * 4;
+
+    float c32[kV8RowGroups][kV4TilesPerWarp][4];
+    std::uint32_t c16[kV8RowGroups][kV4TilesPerWarp][2];
+    #pragma unroll
+    for (int q = 0; q < kV8RowGroups; ++q)
+        #pragma unroll
+        for (int t = 0; t < kV4TilesPerWarp; ++t) {
+            c32[q][t][0] = c32[q][t][1] = c32[q][t][2] = c32[q][t][3] = 0.f;
+            c16[q][t][0] = c16[q][t][1] = 0u;
+        }
+
+    int tokc[kV4TilesPerWarp];
+    #pragma unroll
+    for (int t = 0; t < kV4TilesPerWarp; ++t)
+        tokc[t] = min(tok_base + (warp * kV4TilesPerWarp + t) * kV4Tok + r0, last_tok);
+
+    #pragma unroll
+    for (int q = 0; q < kV8RowGroups; ++q) {
+        const int sr = min(row_base + q * kV4Rows + srow, last_row);
+        if (groups_per_row > 0) {
+            const std::uint8_t* p = codes + (static_cast<std::int64_t>(sr) * groups_per_row) * 32 + soff;
+            __pipeline_memcpy_async(&raw[q][0][tid * 4], p, 4);
+        }
+    }
+    __pipeline_commit();
+
+    for (int g = 0; g < groups_per_row; ++g) {
+        #pragma unroll
+        for (int q = 0; q < kV8RowGroups; ++q) {
+            if (g + 1 < groups_per_row) {
+                const int sr = min(row_base + q * kV4Rows + srow, last_row);
+                const std::uint8_t* p = codes + (static_cast<std::int64_t>(sr) * groups_per_row + (g + 1)) * 32 + soff;
+                __pipeline_memcpy_async(&raw[q][(g + 1) & 1][tid * 4], p, 4);
+            }
+        }
+        if (g + 1 < groups_per_row) { __pipeline_commit(); __pipeline_wait_prior(1); }
+        else                        { __pipeline_wait_prior(0); }
+        __syncthreads();
+
+        #pragma unroll
+        for (int q = 0; q < kV8RowGroups; ++q) {
+            const int dr = tid >> 3;
+            const int dj = tid & 7;
+            const int sr = min(row_base + q * kV4Rows + dr, last_row);
+            const float s = v2_scale(scales, groups_per_row, sr, g);
+            const std::uint8_t* rb = raw[q][g & 1] + dr * 32 + dj * 4;
+            std::uint32_t* d4 = reinterpret_cast<std::uint32_t*>(slab[q] + dr * kV4SlabStride + dj * 16);
+            for (int b = 0; b < 4; ++b) {
+                d4[b * 2 + 0] = v8_pair(rb[b], 0, s);
+                d4[b * 2 + 1] = v8_pair(rb[b], 1, s);
+            }
+        }
+        __syncthreads();
+
+        const __half* a0p[kV8RowGroups];
+        const __half* a1p[kV8RowGroups];
+        #pragma unroll
+        for (int q = 0; q < kV8RowGroups; ++q) {
+            a0p[q] = slab[q] + r0 * kV4SlabStride + cpar * 2;
+            a1p[q] = a0p[q] + 8 * kV4SlabStride;
+        }
+        for (int kt = 0; kt < kV4KTiles; ++kt) {
+            const int kk = kt * 16;
+            std::uint32_t aa[kV8RowGroups][4];
+            #pragma unroll
+            for (int q = 0; q < kV8RowGroups; ++q) {
+                aa[q][0] = *reinterpret_cast<const std::uint32_t*>(a0p[q] + kk);
+                aa[q][1] = *reinterpret_cast<const std::uint32_t*>(a1p[q] + kk);
+                aa[q][2] = *reinterpret_cast<const std::uint32_t*>(a0p[q] + kk + 8);
+                aa[q][3] = *reinterpret_cast<const std::uint32_t*>(a1p[q] + kk + 8);
+            }
+            #pragma unroll
+            for (int t = 0; t < kV4TilesPerWarp; ++t) {
+                const __nv_bfloat16* xb = x + static_cast<std::int64_t>(tokc[t]) * x_row_stride + g * kV4Gk + cpar * 2 + kk;
+                const std::uint32_t b0 = v8_bf2f16(*reinterpret_cast<const std::uint32_t*>(xb));
+                const std::uint32_t b1 = v8_bf2f16(*reinterpret_cast<const std::uint32_t*>(xb + 8));
+                #pragma unroll
+                for (int q = 0; q < kV8RowGroups; ++q) {
+                    v8_mma_f16(aa[q][0], aa[q][1], aa[q][2], aa[q][3], b0, b1, c16[q][t]);
+                }
+            }
+        }
+        #pragma unroll
+        for (int q = 0; q < kV8RowGroups; ++q)
+            #pragma unroll
+            for (int t = 0; t < kV4TilesPerWarp; ++t) {
+                v8_promote(c16[q][t], c32[q][t]);
+                c16[q][t][0] = 0u;
+                c16[q][t][1] = 0u;
+            }
+    }
+
+    #pragma unroll
+    for (int q = 0; q < kV8RowGroups; ++q) {
+        const int rb = row_base + q * kV4Rows;
+        #pragma unroll
+        for (int t = 0; t < kV4TilesPerWarp; ++t) {
+            const int r_lo = rb + r0;
+            const int r_hi = rb + r0 + 8;
+            const int t0 = tok_base + (warp * kV4TilesPerWarp + t) * kV4Tok + cpar * 2;
+            const int t1 = t0 + 1;
+            if (r_lo < rows) {
+                if (t0 < tokens) dst[static_cast<std::int64_t>(t0) * out_row_stride + r_lo] = __float2bfloat16_rn(c32[q][t][0]);
+                if (t1 < tokens) dst[static_cast<std::int64_t>(t1) * out_row_stride + r_lo] = __float2bfloat16_rn(c32[q][t][1]);
+            }
+            if (r_hi < rows) {
+                if (t0 < tokens) dst[static_cast<std::int64_t>(t0) * out_row_stride + r_hi] = __float2bfloat16_rn(c32[q][t][2]);
+                if (t1 < tokens) dst[static_cast<std::int64_t>(t1) * out_row_stride + r_hi] = __float2bfloat16_rn(c32[q][t][3]);
+            }
+        }
+    }
+}
+#endif  // NINFER_TERNARY_V8_B_CUH
diff --git a/src/ops/linear/ternary/v8_c.cuh b/src/ops/linear/ternary/v8_c.cuh
new file mode 100644
index 0000000..9db7741
--- /dev/null
+++ b/src/ops/linear/ternary/v8_c.cuh
@@ -0,0 +1,17 @@
+#ifndef NINFER_TERNARY_V8_C_CUH
+#define NINFER_TERNARY_V8_C_CUH
+#include "v4_a.cuh"  // guarded: v8 reuses v4's tiling constants
+#include "v8_b.cuh"  // guarded
+
+// v8 launcher: v7's shape (64 rows x 128 tokens per CTA, 4 row groups per warp) with the mma in
