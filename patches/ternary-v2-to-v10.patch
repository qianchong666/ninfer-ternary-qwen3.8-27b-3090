+#ifndef NINFER_TERNARY_V4_C_CUH
+#define NINFER_TERNARY_V4_C_CUH
+#include "v4_b.cuh"  // guarded, so it is safe if the unity build already pulled it in
+
+// v4 launcher: one launch covers the whole (row tile x token window) grid; there is no 8-token
+// stepping loop, so each CTA reads and decodes its rows' codes once per k-group and all 128 tokens
+// of the window reuse that slab.
+inline void launch_pq2_mma_v4(const std::uint8_t* codes,
+                              const std::uint8_t* scales,
+                              const __nv_bfloat16* x,
+                              __nv_bfloat16* out,
+                              std::int32_t rows,
+                              std::int32_t groups_per_row,
+                              std::int32_t tokens,
+                              std::int64_t x_row_stride,
+                              std::int64_t out_row_stride,
+                              cudaStream_t stream) {
+    const dim3 grid((rows + kV4Rows - 1) / kV4Rows, (tokens + kV4Cols - 1) / kV4Cols, 1);
+    ternary_pq2_mma_v4_kernel<<<grid, kV4Warps * 32, 0, stream>>>(
+        codes, scales, x, out, rows, groups_per_row, tokens, x_row_stride, out_row_stride);
+}
+#endif  // NINFER_TERNARY_V4_C_CUH
diff --git a/src/ops/linear/ternary/v5_a.cuh b/src/ops/linear/ternary/v5_a.cuh
new file mode 100644
index 0000000..949cec4
--- /dev/null
+++ b/src/ops/linear/ternary/v5_a.cuh
@@ -0,0 +1,22 @@
+#ifndef NINFER_TERNARY_V5_A_CUH
+#define NINFER_TERNARY_V5_A_CUH
+// v5: same CTA shape as v4 (16 rows x 256 tokens) but the mma runs in f16 with an f16 accumulator.
+// Measured on this RTX 3090 (bench/mb_peak.cu): bf16/fp32-acc tops out at 56.0 TFLOPS while
+// f16/fp16-acc reaches 111.6 TFLOPS -- exactly 2x. bf16 has no f16-accumulate mma variant, so both
+// operands must become f16. The ternary weights (+-s, 0) are exact in f16 because the group scale is
+// itself an f16; the activations are RMSNorm outputs of order 1, far inside f16's range.
+//
+// An f16 accumulator over the full k = 5120 would round 5120 times and drift by ~3.5% relative, so
+// accumulation is split: kV5PromoteEvery k-tiles run in the f16 accumulator and are then promoted
+// into fp32 (4 cvt + 4 add per tile per promotion = about one extra instruction per mma).
+constexpr int kV5Warps = 4;
+constexpr int kV5Rows  = 16;
+constexpr int kV5TilesPerWarp = 4;
+constexpr int kV5Tok   = 8;
+constexpr int kV5Cols  = kV5Warps * kV5TilesPerWarp * kV5Tok;  // 16 rows x 128 tokens per CTA
+constexpr int kV5Gk    = 128;
+constexpr int kV5KTiles = kV5Gk / 16;                          // 8 k-tiles per group
+constexpr int kV5SlabStride = kV5Gk + 8;
+constexpr int kV5PromoteEvery = 8;                             // 8 k-tiles = 128 k in f16, then promote
+constexpr int kV5MinChunk = 512;
+#endif  // NINFER_TERNARY_V5_A_CUH
diff --git a/src/ops/linear/ternary/v5_b.cuh b/src/ops/linear/ternary/v5_b.cuh
new file mode 100644
index 0000000..7449bcd
--- /dev/null
+++ b/src/ops/linear/ternary/v5_b.cuh
@@ -0,0 +1,141 @@
+#ifndef NINFER_TERNARY_V5_B_CUH
+#define NINFER_TERNARY_V5_B_CUH
+// v5 kernel: v4's CTA shape (16 rows x 128 tokens, 4 warps x 4 eight-token tiles) with the mma in
+// f16/f16, which measures 2x the bf16/fp32-accumulate rate on this RTX 3090. Accumulation is split:
+// one quantization group (128 k) is summed in the f16 accumulator, then promoted into fp32. The
+// includer supplies v5_a.cuh, ternary_mma_v2.cuh (v2_scale) and cuda_fp16.h; no namespace here.
+
+__device__ __forceinline__ std::uint32_t v5_pair(const std::uint32_t byte, const int half,
+                                                 const float s) {
+    const int shift = half * 4;
+    const float f0 = (float)((int)((byte >> shift) & 3u) - 1) * s;
+    const float f1 = (float)((int)((byte >> (shift + 2)) & 3u) - 1) * s;
+    const __half2 h = __floats2half2_rn(f0, f1);
+    return *reinterpret_cast<const std::uint32_t*>(&h);
+}
+
+__device__ __forceinline__ std::uint32_t v5_bf2f16(const std::uint32_t b) {
+    const __nv_bfloat162 bf = *reinterpret_cast<const __nv_bfloat162*>(&b);
+    const __half2 h = __float22half2_rn(__bfloat1622float2(bf));
+    return *reinterpret_cast<const std::uint32_t*>(&h);
+}
+
+__device__ __forceinline__ void v5_mma_f16(const std::uint32_t a0, const std::uint32_t a1,
+                                           const std::uint32_t a2, const std::uint32_t a3,
+                                           const std::uint32_t b0, const std::uint32_t b1,
+                                           std::uint32_t* c) {
+    asm volatile("mma.sync.aligned.m16n8k16.row.col.f16.f16.f16.f16 "
+                 "{%0,%1},{%2,%3,%4,%5},{%6,%7},{%0,%1};\n"
+                 : "+r"(c[0]), "+r"(c[1])
+                 : "r"(a0), "r"(a1), "r"(a2), "r"(a3), "r"(b0), "r"(b1));
+}
+
+__device__ __forceinline__ void v5_promote(const std::uint32_t* c16, float* c32) {
+    const __half2 lo = *reinterpret_cast<const __half2*>(&c16[0]);
+    const __half2 hi = *reinterpret_cast<const __half2*>(&c16[1]);
+    c32[0] += __low2float(lo);
+    c32[1] += __high2float(lo);
+    c32[2] += __low2float(hi);
+    c32[3] += __high2float(hi);
+}
+
+template <bool kConvB>
+__global__ __launch_bounds__(kV5Warps * 32) void ternary_pq2_mma_v5_kernel(
+        const std::uint8_t* __restrict__ codes,
+        const std::uint8_t* __restrict__ scales,
+        const __nv_bfloat16* __restrict__ x,
+        __nv_bfloat16* __restrict__ dst,
+        int rows, int groups_per_row, int tokens, int x_row_stride, int out_row_stride) {
+    __shared__ __half slab[kV5Rows * kV5SlabStride];
+    __shared__ std::uint8_t raw[kV5Rows * 32];
+
+    const int tid = threadIdx.x;
+    const int warp = tid >> 5;
+    const int lane = tid & 31;
+    const int r0 = lane >> 2;
+    const int cpar = lane & 3;
+    const int row_base = blockIdx.x * kV5Rows;
+    const int tok_base = blockIdx.y * kV5Cols;
+    const int last_row = (rows > 0) ? (rows - 1) : 0;
+    const int last_tok = (tokens > 0) ? (tokens - 1) : 0;
+
+    float c32[kV5TilesPerWarp][4];
+    std::uint32_t c16[kV5TilesPerWarp][2];
+    int tokc[kV5TilesPerWarp];
+    #pragma unroll
+    for (int t = 0; t < kV5TilesPerWarp; ++t) {
+        c32[t][0] = c32[t][1] = c32[t][2] = c32[t][3] = 0.f;
+        c16[t][0] = c16[t][1] = 0u;
+        tokc[t] = min(tok_base + (warp * kV5TilesPerWarp + t) * kV5Tok + r0, last_tok);
+    }
+
+    for (int g = 0; g < groups_per_row; ++g) {
+        __syncthreads();
+        {   // stage this group's packed codes for the CTA's 16 rows
+            const int srow = tid >> 3;
+            const int soff = (tid & 7) * 4;
+            const int sr = min(row_base + srow, last_row);
+            const std::uint8_t* p = codes + ((std::int64_t)sr * groups_per_row + g) * 32 + soff;
+            const std::uint32_t v = (std::uint32_t)p[0] | ((std::uint32_t)p[1] << 8) |
+                                    ((std::uint32_t)p[2] << 16) | ((std::uint32_t)p[3] << 24);
+            reinterpret_cast<std::uint32_t*>(raw)[tid] = v;
+        }
+        {   // decode once into the f16 slab, group scale folded in (exact: +-s and 0)
+            const int dr = tid >> 3;
+            const int dj = tid & 7;
+            const int sr = min(row_base + dr, last_row);
+            const float s = v2_scale(scales, groups_per_row, sr, g);
+            const std::uint8_t* rb = raw + dr * 32 + dj * 4;
+            std::uint32_t* d4 = reinterpret_cast<std::uint32_t*>(slab + dr * kV5SlabStride + dj * 16);
+            for (int b = 0; b < 4; ++b) {
+                d4[b * 2 + 0] = v5_pair(rb[b], 0, s);
+                d4[b * 2 + 1] = v5_pair(rb[b], 1, s);
+            }
+        }
+        __syncthreads();
+
+        const __half* ar  = slab + r0 * kV5SlabStride + cpar * 2;
+        const __half* ar8 = ar + 8 * kV5SlabStride;
+        for (int kt = 0; kt < kV5KTiles; ++kt) {
+            const int kk = kt * 16;
+            const std::uint32_t a0 = *reinterpret_cast<const std::uint32_t*>(ar + kk);
+            const std::uint32_t a1 = *reinterpret_cast<const std::uint32_t*>(ar8 + kk);
+            const std::uint32_t a2 = *reinterpret_cast<const std::uint32_t*>(ar + kk + 8);
+            const std::uint32_t a3 = *reinterpret_cast<const std::uint32_t*>(ar8 + kk + 8);
+            #pragma unroll
+            for (int t = 0; t < kV5TilesPerWarp; ++t) {
+                const __nv_bfloat16* xb =
+                    x + (std::int64_t)tokc[t] * x_row_stride + g * kV5Gk + cpar * 2 + kk;
+                const std::uint32_t b0 = kConvB ? v5_bf2f16(*reinterpret_cast<const std::uint32_t*>(xb))
+                                                : *reinterpret_cast<const std::uint32_t*>(xb);
+                const std::uint32_t b1 = kConvB ? v5_bf2f16(*reinterpret_cast<const std::uint32_t*>(xb + 8))
+                                                : *reinterpret_cast<const std::uint32_t*>(xb + 8);
+                v5_mma_f16(a0, a1, a2, a3, b0, b1, c16[t]);
+            }
+        }
+        // one group is done: promote the f16 partial into fp32 and start a fresh f16 partial
+        #pragma unroll
+        for (int t = 0; t < kV5TilesPerWarp; ++t) {
+            v5_promote(c16[t], c32[t]);
+            c16[t][0] = 0u;
+            c16[t][1] = 0u;
+        }
+    }
+
+    #pragma unroll
+    for (int t = 0; t < kV5TilesPerWarp; ++t) {
+        const int r_lo = row_base + r0;
+        const int r_hi = row_base + r0 + 8;
+        const int t0 = tok_base + (warp * kV5TilesPerWarp + t) * kV5Tok + cpar * 2;
+        const int t1 = t0 + 1;
+        if (r_lo < rows) {
+            if (t0 < tokens) dst[(std::int64_t)t0 * out_row_stride + r_lo] = __float2bfloat16_rn(c32[t][0]);
+            if (t1 < tokens) dst[(std::int64_t)t1 * out_row_stride + r_lo] = __float2bfloat16_rn(c32[t][1]);
+        }
+        if (r_hi < rows) {
+            if (t0 < tokens) dst[(std::int64_t)t0 * out_row_stride + r_hi] = __float2bfloat16_rn(c32[t][2]);
+            if (t1 < tokens) dst[(std::int64_t)t1 * out_row_stride + r_hi] = __float2bfloat16_rn(c32[t][3]);
+        }
+    }
+}
+#endif  // NINFER_TERNARY_V5_B_CUH
diff --git a/src/ops/linear/ternary/v5_c.cuh b/src/ops/linear/ternary/v5_c.cuh
new file mode 100644
index 0000000..5051e2c
--- /dev/null
+++ b/src/ops/linear/ternary/v5_c.cuh
@@ -0,0 +1,30 @@
+#ifndef NINFER_TERNARY_V5_C_CUH
+#define NINFER_TERNARY_V5_C_CUH
+#include "v5_b.cuh"  // guarded
+
+// v5 launcher: one launch covers the whole (rows x tokens) prefill GEMM. tokens need not be a
+// multiple of kV5Cols -- reads are clamped and only the store is predicated (the bug that made the
+// v3 kernel deadlock on exactly the 4636-token chunk the engine hands it).
+inline void launch_pq2_mma_v5(const std::uint8_t* codes, const std::uint8_t* scales,
+                              const __nv_bfloat16* x, __nv_bfloat16* out,
+                              std::int32_t rows, std::int32_t groups_per_row, std::int32_t tokens,
+                              std::int64_t x_row_stride, std::int64_t out_row_stride,
+                              cudaStream_t stream) {
+    const dim3 grid((rows + kV5Rows - 1) / kV5Rows, (tokens + kV5Cols - 1) / kV5Cols, 1);
+    ternary_pq2_mma_v5_kernel<true><<<grid, kV5Warps * 32, 0, stream>>>(
+        codes, scales, x, out, rows, groups_per_row, tokens, x_row_stride, out_row_stride);
+}
+
+// Timing-only twin: the B operand is read as if it were already f16, so the bf16->f16 conversion in
+// the tile loop is skipped. The numbers are garbage but the memory traffic is identical, which makes
+// this a fair measure of what that conversion costs.
+inline void launch_pq2_mma_v5_noconv(const std::uint8_t* codes, const std::uint8_t* scales,
+                                     const __nv_bfloat16* x, __nv_bfloat16* out,
+                                     std::int32_t rows, std::int32_t groups_per_row,
+                                     std::int32_t tokens, std::int64_t x_row_stride,
+                                     std::int64_t out_row_stride, cudaStream_t stream) {
+    const dim3 grid((rows + kV5Rows - 1) / kV5Rows, (tokens + kV5Cols - 1) / kV5Cols, 1);
+    ternary_pq2_mma_v5_kernel<false><<<grid, kV5Warps * 32, 0, stream>>>(
+        codes, scales, x, out, rows, groups_per_row, tokens, x_row_stride, out_row_stride);
+}
+#endif  // NINFER_TERNARY_V5_C_CUH
diff --git a/src/ops/linear/ternary/v6_b.cuh b/src/ops/linear/ternary/v6_b.cuh
new file mode 100644
index 0000000..4960647
--- /dev/null
+++ b/src/ops/linear/ternary/v6_b.cuh
@@ -0,0 +1,110 @@
+#ifndef NINFER_TERNARY_V6_B_CUH
+#define NINFER_TERNARY_V6_B_CUH
+// v6 = v4 + a software pipeline for the staging load. Measured in the microbench: v4 runs at ~46% of
+// the fp32-accumulate mma peak and neither f16 accumulation nor removing the bf16->f16 conversion
+// helped, which says the kernel is not tensor-pipe bound at all. Each group's staging is a serial
+// phase (global load -> shared memory) whose DRAM latency (~800 cycles) is comparable to the whole
+// consume (~768 cycles), and nothing overlaps it. v6 issues an async copy for group g+1 before
+// consuming group g, so that latency retires behind the mma work. Constants come from v4_a.cuh.
+#include <cuda_pipeline.h>
+
+__global__ __launch_bounds__(kV4Warps * 32) void ternary_pq2_mma_v6_kernel(
+        const std::uint8_t* __restrict__ codes,
+        const std::uint8_t* __restrict__ scales,
+        const __nv_bfloat16* __restrict__ x,
+        __nv_bfloat16* __restrict__ dst,
+        int rows, int groups_per_row, int tokens, int x_row_stride, int out_row_stride) {
+    __shared__ __nv_bfloat16 slab[kV4Rows * kV4SlabStride];
+    __shared__ std::uint8_t raw[2][kV4Rows * 32];
+
+    const int tid = threadIdx.x;
+    const int warp = tid >> 5;
+    const int lane = tid & 31;
+    const int r0 = lane >> 2;
+    const int cpar = lane & 3;
+    const int row_base = blockIdx.x * kV4Rows;
+    const int tok_base = blockIdx.y * kV4Cols;
+    const int last_row = (rows > 0) ? (rows - 1) : 0;
+    const int last_tok = (tokens > 0) ? (tokens - 1) : 0;
+    const int srow = tid >> 3;
+    const int soff = (tid & 7) * 4;
+    const int srow_c = min(row_base + srow, last_row);
+
+    float c[kV4TilesPerWarp][4];
+    #pragma unroll
+    for (int t = 0; t < kV4TilesPerWarp; ++t) { c[t][0] = c[t][1] = c[t][2] = c[t][3] = 0.f; }
+    int tokc[kV4TilesPerWarp];
+    #pragma unroll
+    for (int t = 0; t < kV4TilesPerWarp; ++t) {
+        tokc[t] = min(tok_base + (warp * kV4TilesPerWarp + t) * kV4Tok + r0, last_tok);
+    }
+
+    if (groups_per_row > 0) {
+        const std::uint8_t* p = codes + ((std::int64_t)srow_c * groups_per_row) * 32 + soff;
+        __pipeline_memcpy_async(&raw[0][tid * 4], p, 4);
+    }
+    __pipeline_commit();
+
+    for (int g = 0; g < groups_per_row; ++g) {
+        // issue next group's copy first: it flies while we run this group's mma work
+        if (g + 1 < groups_per_row) {
+            const std::uint8_t* p = codes + ((std::int64_t)srow_c * groups_per_row + (g + 1)) * 32 + soff;
+            __pipeline_memcpy_async(&raw[(g + 1) & 1][tid * 4], p, 4);
+            __pipeline_commit();
+            __pipeline_wait_prior(1);   // this group's bytes have landed, next group still in flight
+        } else {
+            __pipeline_wait_prior(0);
+        }
+        __syncthreads();
+
+        {   // decode group g once, scale folded in
+            const int dr = tid >> 3;
+            const int dj = tid & 7;
+            const int sr = min(row_base + dr, last_row);
+            const float s = v2_scale(scales, groups_per_row, sr, g);
+            const std::uint8_t* rb = raw[g & 1] + dr * 32 + dj * 4;
+            std::uint32_t* d4 = reinterpret_cast<std::uint32_t*>(slab + dr * kV4SlabStride + dj * 16);
+            for (int b = 0; b < 4; ++b) {
+                d4[b * 2 + 0] = v2_pair(rb[b], 0, s);
+                d4[b * 2 + 1] = v2_pair(rb[b], 1, s);
+            }
+        }
+        __syncthreads();
+
+        {   // consume: the A fragment loads are hoisted out of the tile loop
+            const __nv_bfloat16* ar  = slab + r0 * kV4SlabStride + cpar * 2;
+            const __nv_bfloat16* ar8 = ar + 8 * kV4SlabStride;
+            for (int kt = 0; kt < kV4KTiles; ++kt) {
+                const int kk = kt * 16;
+                const std::uint32_t a0 = *reinterpret_cast<const std::uint32_t*>(ar + kk);
+                const std::uint32_t a1 = *reinterpret_cast<const std::uint32_t*>(ar8 + kk);
+                const std::uint32_t a2 = *reinterpret_cast<const std::uint32_t*>(ar + kk + 8);
+                const std::uint32_t a3 = *reinterpret_cast<const std::uint32_t*>(ar8 + kk + 8);
+                #pragma unroll
+                for (int t = 0; t < kV4TilesPerWarp; ++t) {
+                    const __nv_bfloat16* xb = x + (std::int64_t)tokc[t] * x_row_stride + g * kV4Gk + cpar * 2 + kk;
+                    const std::uint32_t b0 = *reinterpret_cast<const std::uint32_t*>(xb);
+                    const std::uint32_t b1 = *reinterpret_cast<const std::uint32_t*>(xb + 8);
+                    v2_mma_bf16(a0, a1, a2, a3, b0, b1, c[t]);
+                }
+            }
+        }
+    }
+
+    #pragma unroll
+    for (int t = 0; t < kV4TilesPerWarp; ++t) {
+        const int r_lo = row_base + r0;
+        const int r_hi = row_base + r0 + 8;
+        const int t0 = tok_base + (warp * kV4TilesPerWarp + t) * kV4Tok + cpar * 2;
+        const int t1 = t0 + 1;
+        if (r_lo < rows) {
+            if (t0 < tokens) dst[(std::int64_t)t0 * out_row_stride + r_lo] = __float2bfloat16_rn(c[t][0]);
+            if (t1 < tokens) dst[(std::int64_t)t1 * out_row_stride + r_lo] = __float2bfloat16_rn(c[t][1]);
+        }
+        if (r_hi < rows) {
+            if (t0 < tokens) dst[(std::int64_t)t0 * out_row_stride + r_hi] = __float2bfloat16_rn(c[t][2]);
+            if (t1 < tokens) dst[(std::int64_t)t1 * out_row_stride + r_hi] = __float2bfloat16_rn(c[t][3]);
+        }
+    }
+}
+#endif  // NINFER_TERNARY_V6_B_CUH
diff --git a/src/ops/linear/ternary/v6_c.cuh b/src/ops/linear/ternary/v6_c.cuh
new file mode 100644
index 0000000..bb7358e
--- /dev/null
+++ b/src/ops/linear/ternary/v6_c.cuh
@@ -0,0 +1,17 @@
+#ifndef NINFER_TERNARY_V6_C_CUH
+#define NINFER_TERNARY_V6_C_CUH
+#include "v4_a.cuh"  // guarded: v6 reuses v4's tiling constants
+#include "v6_b.cuh"  // guarded
+
+// v6 launcher: v4's tiling with the staging load pipelined. tokens need not be a multiple of
+// kV4Cols; every read is clamped and only the final store is predicated.
+inline void launch_pq2_mma_v6(const std::uint8_t* codes, const std::uint8_t* scales,
+                              const __nv_bfloat16* x, __nv_bfloat16* out,
+                              std::int32_t rows, std::int32_t groups_per_row, std::int32_t tokens,
+                              std::int64_t x_row_stride, std::int64_t out_row_stride,
+                              cudaStream_t stream) {
+    const dim3 grid((rows + kV4Rows - 1) / kV4Rows, (tokens + kV4Cols - 1) / kV4Cols, 1);
+    ternary_pq2_mma_v6_kernel<<<grid, kV4Warps * 32, 0, stream>>>(
+        codes, scales, x, out, rows, groups_per_row, tokens, x_row_stride, out_row_stride);
+}
+#endif  // NINFER_TERNARY_V6_C_CUH
diff --git a/src/ops/linear/ternary/v7_b.cuh b/src/ops/linear/ternary/v7_b.cuh
new file mode 100644
index 0000000..12aed23
--- /dev/null
+++ b/src/ops/linear/ternary/v7_b.cuh
@@ -0,0 +1,136 @@
+#ifndef NINFER_TERNARY_V7_B_CUH
+#define NINFER_TERNARY_V7_B_CUH
+// v7 = v6 + taller row tiles. ncu on v6: 66.8% of the issue interval is stalled on an L1TEX
+// (global) scoreboard dependency, i.e. the activation operand. Its L2 traffic is
+// rows*tokens*k*2/16 bytes per launch because one CTA covers only 16 rows, and at ~1.6 TB/s that
+// traffic alone accounts for the whole runtime. Each warp now walks kV7RowGroups row groups of 16
+// with the SAME activation registers, so the B loads (and their L2 traffic) divide by
+// kV7RowGroups. The row groups must live in one warp: registers are not shared between warps.
+// Constants come from v4_a.cuh; the included supplies v4_a.cuh and ternary_mma_v2.cuh.
+#include <cuda_pipeline.h>
+
+constexpr int kV7RowGroups = 4;              // 16-row mma row groups per warp
+constexpr int kV7Rows      = kV4Rows * kV7RowGroups;   // 32 rows per CTA
+
+__global__ __launch_bounds__(kV4Warps * 32) void ternary_pq2_mma_v7_kernel(
+        const std::uint8_t* __restrict__ codes,
+        const std::uint8_t* __restrict__ scales,
+        const __nv_bfloat16* __restrict__ x,
+        __nv_bfloat16* __restrict__ dst,
+        int rows, int groups_per_row, int tokens, int x_row_stride, int out_row_stride) {
+    __shared__ __nv_bfloat16 slab[kV7RowGroups][kV4Rows * kV4SlabStride];
+    __shared__ std::uint8_t raw[kV7RowGroups][2][kV4Rows * 32];
+
+    const int tid = threadIdx.x;
+    const int warp = tid >> 5;
+    const int lane = tid & 31;
+    const int r0 = lane >> 2;
+    const int cpar = lane & 3;
+    const int row_base = blockIdx.x * kV7Rows;
+    const int tok_base = blockIdx.y * kV4Cols;
+    const int last_row = (rows > 0) ? (rows - 1) : 0;
+    const int last_tok = (tokens > 0) ? (tokens - 1) : 0;
+    const int srow = tid >> 3;
+    const int soff = (tid & 7) * 4;
+
+    float c[kV7RowGroups][kV4TilesPerWarp][4];
+    #pragma unroll
+    for (int q = 0; q < kV7RowGroups; ++q)
+        #pragma unroll
+        for (int t = 0; t < kV4TilesPerWarp; ++t) { c[q][t][0]=c[q][t][1]=c[q][t][2]=c[q][t][3]=0.f; }
+
+    int tokc[kV4TilesPerWarp];
+    #pragma unroll
+    for (int t = 0; t < kV4TilesPerWarp; ++t)
+        tokc[t] = min(tok_base + (warp * kV4TilesPerWarp + t) * kV4Tok + r0, last_tok);
+
+    // staging: each thread copies 4 bytes of every row group's group-0 codes
+    #pragma unroll
+    for (int q = 0; q < kV7RowGroups; ++q) {
+        const int sr = min(row_base + q * kV4Rows + srow, last_row);
+        if (groups_per_row > 0) {
+            const std::uint8_t* p = codes + ((std::int64_t)sr * groups_per_row) * 32 + soff;
+            __pipeline_memcpy_async(&raw[q][0][tid * 4], p, 4);
+        }
+    }
+    __pipeline_commit();
+
+    for (int g = 0; g < groups_per_row; ++g) {
+        #pragma unroll
+        for (int q = 0; q < kV7RowGroups; ++q) {
+            if (g + 1 < groups_per_row) {
+                const int sr = min(row_base + q * kV4Rows + srow, last_row);
+                const std::uint8_t* p = codes + ((std::int64_t)sr * groups_per_row + (g + 1)) * 32 + soff;
+                __pipeline_memcpy_async(&raw[q][(g + 1) & 1][tid * 4], p, 4);
+            }
+        }
+        if (g + 1 < groups_per_row) { __pipeline_commit(); __pipeline_wait_prior(1); }
+        else                        { __pipeline_wait_prior(0); }
+        __syncthreads();
+
+        #pragma unroll
+        for (int q = 0; q < kV7RowGroups; ++q) {   // decode this group for both row groups
+            const int dr = tid >> 3;
+            const int dj = tid & 7;
+            const int sr = min(row_base + q * kV4Rows + dr, last_row);
+            const float s = v2_scale(scales, groups_per_row, sr, g);
+            const std::uint8_t* rb = raw[q][g & 1] + dr * 32 + dj * 4;
+            std::uint32_t* d4 = reinterpret_cast<std::uint32_t*>(slab[q] + dr * kV4SlabStride + dj * 16);
+            for (int b = 0; b < 4; ++b) {
+                d4[b * 2 + 0] = v2_pair(rb[b], 0, s);
+                d4[b * 2 + 1] = v2_pair(rb[b], 1, s);
+            }
+        }
+        __syncthreads();
+
+        const __nv_bfloat16* a0p[kV7RowGroups];
+        const __nv_bfloat16* a1p[kV7RowGroups];
+        #pragma unroll
+        for (int q = 0; q < kV7RowGroups; ++q) {
+            a0p[q] = slab[q] + r0 * kV4SlabStride + cpar * 2;
+            a1p[q] = a0p[q] + 8 * kV4SlabStride;
+        }
+        for (int kt = 0; kt < kV4KTiles; ++kt) {
+            const int kk = kt * 16;
+            std::uint32_t aa[kV7RowGroups][4];
+            #pragma unroll
+            for (int q = 0; q < kV7RowGroups; ++q) {
+                aa[q][0] = *reinterpret_cast<const std::uint32_t*>(a0p[q] + kk);
+                aa[q][1] = *reinterpret_cast<const std::uint32_t*>(a1p[q] + kk);
+                aa[q][2] = *reinterpret_cast<const std::uint32_t*>(a0p[q] + kk + 8);
+                aa[q][3] = *reinterpret_cast<const std::uint32_t*>(a1p[q] + kk + 8);
+            }
+            #pragma unroll
+            for (int t = 0; t < kV4TilesPerWarp; ++t) {
+                const __nv_bfloat16* xb = x + (std::int64_t)tokc[t] * x_row_stride + g * kV4Gk + cpar * 2 + kk;
+                const std::uint32_t b0 = *reinterpret_cast<const std::uint32_t*>(xb);
+                const std::uint32_t b1 = *reinterpret_cast<const std::uint32_t*>(xb + 8);
+                #pragma unroll
+                for (int q = 0; q < kV7RowGroups; ++q) {
+                    v2_mma_bf16(aa[q][0], aa[q][1], aa[q][2], aa[q][3], b0, b1, c[q][t]);
+                }
+            }
+        }
+    }
+
+    #pragma unroll
+    for (int q = 0; q < kV7RowGroups; ++q) {
+        const int rb = row_base + q * kV4Rows;
+        #pragma unroll
+        for (int t = 0; t < kV4TilesPerWarp; ++t) {
+            const int r_lo = rb + r0;
+            const int r_hi = rb + r0 + 8;
+            const int t0 = tok_base + (warp * kV4TilesPerWarp + t) * kV4Tok + cpar * 2;
+            const int t1 = t0 + 1;
+            if (r_lo < rows) {
+                if (t0 < tokens) dst[(std::int64_t)t0 * out_row_stride + r_lo] = __float2bfloat16_rn(c[q][t][0]);
+                if (t1 < tokens) dst[(std::int64_t)t1 * out_row_stride + r_lo] = __float2bfloat16_rn(c[q][t][1]);
+            }
+            if (r_hi < rows) {
+                if (t0 < tokens) dst[(std::int64_t)t0 * out_row_stride + r_hi] = __float2bfloat16_rn(c[q][t][2]);
+                if (t1 < tokens) dst[(std::int64_t)t1 * out_row_stride + r_hi] = __float2bfloat16_rn(c[q][t][3]);
+            }
+        }
+    }
+}
+#endif  // NINFER_TERNARY_V7_B_CUH
diff --git a/src/ops/linear/ternary/v7_c.cuh b/src/ops/linear/ternary/v7_c.cuh
