+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+
+#include <cstdint>
+
+namespace ninfer::ops::detail {
+
+// The decode-shaped GEMV that replaces the reference kernel at T == 1 lives in
+// ternary_rowsplit_gemv.cuh. It is deliberately NOT included here yet: the CUDA 13.3 cudafe++
+// front end dies (0xC0000409) on that kernel in this translation unit, so it stays out of the built
+// header until the construct is pinned down.
+
+// Correctness-first reference path for the ternary row-split formats.
+//
+// One CTA owns one output row and a tile of kTileT tokens. The CTA has exactly kGroupK
+// (128) threads, so thread `index` owns weight `index` inside every 128-weight group:
+// a group is decoded once by the whole CTA and reused across the whole token tile, which
+// is what keeps this from being 128x redundant. This is the "dequantize the block and
+// accumulate in F32" shape that upstream's reference kernel uses; a repack/SIMT fast path
+// and an MMA path are deliberately left out until the numerics are pinned down.
+//
+// Activation layout is [K, T] with ne[0] = K CONTIGUOUS, i.e. the ninfer/ggml convention: element
+// (column, token) lives at token * k + column. Output is [N, T] the same way: (row, token) at
+// token * rows + row. Treating either as row-major ([K, T] with k*T + t) scrambles every prefill
+// while T == 1 still works, because the two layouts coincide exactly at one token.
+template <class Storage, class Atom, int kTileT>
+__global__ __launch_bounds__(Storage::kGroupK)
+void ternary_rowsplit_gemm_kernel(const __nv_bfloat16* __restrict__ x,
+                                  const std::uint8_t* __restrict__ codes,
+                                  const std::uint8_t* __restrict__ high,
+                                  const std::uint8_t* __restrict__ scales,
+                                  __nv_bfloat16* __restrict__ out, std::int32_t rows,
+                                  std::int32_t k, std::int32_t t, std::int32_t groups_per_row,
+                                  std::int32_t out_row_stride) {
+    static_assert(kTileT >= 1, "the ternary GEMM needs a positive token tile");
+    constexpr int kThreads = Storage::kGroupK;
+
+    const int row = static_cast<int>(blockIdx.x);
+    if (row >= rows) { return; }
+    const int t0 = static_cast<int>(blockIdx.y) * kTileT;
+
+    // Planes are laid out row-major over [rows, groups_per_row].
+    const std::uint8_t* code_row =
+        codes + static_cast<std::int64_t>(row) * groups_per_row * Storage::kCodeBytesPerGroup;
+    const std::uint8_t* high_row =
+        high == nullptr ? nullptr
+                        : high + static_cast<std::int64_t>(row) * groups_per_row *
+                                     Storage::kHighBytesPerGroup;
+    const std::uint8_t* scale_row =
+        scales + static_cast<std::int64_t>(row) * groups_per_row * Storage::kScaleBytesPerGroup;
+
+    const int index = static_cast<int>(threadIdx.x);
+
+    float accumulator[kTileT];
+#pragma unroll
+    for (int i = 0; i < kTileT; ++i) { accumulator[i] = 0.0f; }
+
+    for (int group = 0; group < groups_per_row; ++group) {
+        const std::uint8_t* group_codes = code_row + group * Storage::kCodeBytesPerGroup;
+        const std::uint8_t* group_high =
+            high_row == nullptr ? nullptr : high_row + group * Storage::kHighBytesPerGroup;
+        const float scale = Atom::load_scale(scale_row + group * Storage::kScaleBytesPerGroup);
+        const float weight = Atom::decode_one(group_codes, group_high, scale, index);
+
+        const std::int32_t column = group * Storage::kGroupK + index;
+        if (column < k) {
+#pragma unroll
+            for (int i = 0; i < kTileT; ++i) {
+                const std::int32_t token = t0 + i;
+                if (token < t) {
+                    accumulator[i] += weight *
+                        __bfloat162float(x[static_cast<std::int64_t>(token) * k + column]);
+                }
+            }
+        }
+    }
+
+    __shared__ float partials[kTileT][kThreads];
+#pragma unroll
+    for (int i = 0; i < kTileT; ++i) { partials[i][index] = accumulator[i]; }
+    __syncthreads();
+
+    // Tree reduction over the CTA; every stage halves the active thread range.
+    for (int stride = kThreads / 2; stride > 0; stride >>= 1) {
+        if (index < stride) {
+#pragma unroll
+            for (int i = 0; i < kTileT; ++i) { partials[i][index] += partials[i][index + stride]; }
+        }
+        __syncthreads();
+    }
+
+    if (index == 0) {
+#pragma unroll
+        for (int i = 0; i < kTileT; ++i) {
+            const std::int32_t token = t0 + i;
+            if (token < t) {
+                // out_row_stride is the PARENT's row count, so several projections can write
+                // disjoint row ranges of one fused output (the GDN split parent, for instance).
+                out[static_cast<std::int64_t>(token) * out_row_stride + row] =
+                    __float2bfloat16_rn(partials[i][0]);
+            }
+        }
+    }
+}
+
+} // namespace ninfer::ops::detail
diff --git a/src/ops/linear/ternary/ternary_rowsplit_gemv.cuh b/src/ops/linear/ternary/ternary_rowsplit_gemv.cuh
new file mode 100644
index 0000000..cee2def
--- /dev/null
+++ b/src/ops/linear/ternary/ternary_rowsplit_gemv.cuh
@@ -0,0 +1,164 @@
+// MODIFIED for the NInfer ternary port (Ternary Bonsai 2 27B on NInfer / Ada sm_89).
+// This file differs from upstream NInfer; see patches/ in the release bundle
+// for the change list, rebuild steps and required verification.
+#pragma once
+
+// Decode-shaped ternary GEMV (T == 1) for PQ2_0: one warp owns one output row.
+//
+// Why: the reference kernel in ternary_rowsplit_gemm.cuh gives each output row a full 128-thread
+// CTA and seven block-wide barriers. That is fine for correctness but leaves decode far from the
+// card's measured bandwidth. Here each lane covers four consecutive weights of every 128-group, so
+// a warp reads exactly one 32-byte code span plus one 2-byte scale per group and reduces through
+// shuffles with no __syncthreads at all.
+//
+// PQ2_0 packing makes the mapping exact rather than approximate: a group is 32 bytes holding four
+// two-bit codes each, so for lane l the four columns 4l..4l+3 live entirely in byte l. Lane l
+// loads one byte, decodes four weights, and consumes four bf16 activations.
+//
+// Occupancy, not instruction count, is what this kernel is tuned for: a GEMV needs many warps in
+// flight to cover DRAM latency. A two-rows-per-warp variant (which reuses the activation loads)
+// measured SLOWER (32.8 vs 46.4 t/s) because the extra accumulators and row bases cost registers
+// and dropped the resident warp count. So: one row per warp, and only the micro-optimisations that
+// remove instructions without adding state -- one 16-bit scale load, paired bf16 activation
+// loads, and the per-group scale multiply hoisted out of the four FMAs.
+//
+// LAYOUT: ninfer/ggml put ne[0] on the contiguous axis, so a [k, 1] activation keeps element
+// (column, 0) at column, and a one-token output row is simply out[row].
+
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+
+#include <cstdint>
+
+namespace ninfer::ops::detail {
+
+// Warps per block for the GEMV below.
+inline constexpr int kGemvWarpsPerBlock = 8;
+
+inline constexpr int kGemvCodeBytesPerGroup  = 32;
+inline constexpr int kGemvScaleBytesPerGroup = 2;
+inline constexpr int kGemvGroupK             = 128;
+
+__device__ __forceinline__ float gemv_scale(const std::uint8_t* scale_ptr) {
+    // One 16-bit load instead of two byte loads plus a shift/or; the scale plane is 2-byte aligned.
+    const std::uint16_t bits = *reinterpret_cast<const std::uint16_t*>(scale_ptr);
+    return __half2float(__ushort_as_half(bits));
+}
+
+__global__ __launch_bounds__(kGemvWarpsPerBlock * 32)
+void ternary_pq2_gemv_kernel(const __nv_bfloat16* __restrict__ x,
+                             const std::uint8_t* __restrict__ codes,
+                             const std::uint8_t* __restrict__ scales,
+                             __nv_bfloat16* __restrict__ out, std::int32_t rows,
+                             std::int32_t groups_per_row) {
+    const int lane = static_cast<int>(threadIdx.x) & 31;
+    const int warp =
+        static_cast<int>(blockIdx.x) * kGemvWarpsPerBlock + (static_cast<int>(threadIdx.x) >> 5);
+    if (warp >= rows) { return; }
+
+    const std::uint8_t* code_row =
+        codes + static_cast<std::int64_t>(warp) * groups_per_row * kGemvCodeBytesPerGroup;
+    const std::uint8_t* scale_row =
+        scales + static_cast<std::int64_t>(warp) * groups_per_row * kGemvScaleBytesPerGroup;
+
+    float accumulator = 0.0f;
+
+    for (int group = 0; group < groups_per_row; ++group) {
+        const std::int32_t base = group * kGemvGroupK + lane * 4;
+        const float2 low        = __bfloat1622float2(
+            *reinterpret_cast<const __nv_bfloat162*>(x + base));
+        const float2 high = __bfloat1622float2(
+            *reinterpret_cast<const __nv_bfloat162*>(x + base + 2));
+
+        const std::uint8_t raw = code_row[group * kGemvCodeBytesPerGroup + lane];
+        const float dot = fmaf(static_cast<float>(static_cast<int>(raw & 3u) - 1), low.x,
+                               fmaf(static_cast<float>(static_cast<int>((raw >> 2) & 3u) - 1),
+                                    low.y,
+                                    fmaf(static_cast<float>(static_cast<int>((raw >> 4) & 3u) - 1),
+                                         high.x,
+                                         static_cast<float>(static_cast<int>((raw >> 6) & 3u) - 1) *
+                                             high.y)));
+        accumulator = fmaf(gemv_scale(scale_row + group * kGemvScaleBytesPerGroup), dot,
+                           accumulator);
+    }
+
+#pragma unroll
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        accumulator += __shfl_down_sync(0xffffffffu, accumulator, offset);
+    }
+    if (lane == 0) { out[warp] = __float2bfloat16_rn(accumulator); }
+}
+
+// Small-token-tile variant, for the speculative VERIFY pass (T = draft + 1, i.e. 2..4).
+//
+// A per-token GEMV would re-read every weight for every token, and weights are exactly what the
+// decode path is bound by, so a verify round would cost T full decode passes and speculation could
+// never pay for itself (measured: 15.7 t/s with MTP N=2 against 62.1 t/s without). This kernel
+// keeps the weights single-read: the code byte and scale are loaded once per group and reused for
+// all kT tokens, while each token contributes its own four activations.
+template <int kT>
+__global__ __launch_bounds__(kGemvWarpsPerBlock * 32)
+void ternary_pq2_gemv_tile_kernel(const __nv_bfloat16* __restrict__ x,
+                                  const std::uint8_t* __restrict__ codes,
+                                  const std::uint8_t* __restrict__ scales,
+                                  __nv_bfloat16* __restrict__ out, std::int32_t rows,
+                                  std::int32_t groups_per_row, std::int32_t tokens,
+                                  std::int32_t out_row_stride) {
+    static_assert(kT >= 1 && kT <= 8, "tile size must be small enough to keep accumulators in registers");
+    const int lane = static_cast<int>(threadIdx.x) & 31;
+    const int warp =
+        static_cast<int>(blockIdx.x) * kGemvWarpsPerBlock + (static_cast<int>(threadIdx.x) >> 5);
+    if (warp >= rows) { return; }
+
+    const std::uint8_t* code_row =
+        codes + static_cast<std::int64_t>(warp) * groups_per_row * kGemvCodeBytesPerGroup;
+    const std::uint8_t* scale_row =
+        scales + static_cast<std::int64_t>(warp) * groups_per_row * kGemvScaleBytesPerGroup;
+
+    float accumulator[kT];
+#pragma unroll
+    for (int t = 0; t < kT; ++t) { accumulator[t] = 0.0f; }
+
+    for (int group = 0; group < groups_per_row; ++group) {
+        // Weights: one byte of codes + one 16-bit scale, reused across every token in the tile.
+        const std::uint8_t raw = code_row[group * kGemvCodeBytesPerGroup + lane];
+        const float scale = gemv_scale(scale_row + group * kGemvScaleBytesPerGroup);
+        const float weight0 = static_cast<float>(static_cast<int>(raw & 3u) - 1);
+        const float weight1 = static_cast<float>(static_cast<int>((raw >> 2) & 3u) - 1);
+        const float weight2 = static_cast<float>(static_cast<int>((raw >> 4) & 3u) - 1);
+        const float weight3 = static_cast<float>(static_cast<int>((raw >> 6) & 3u) - 1);
+
+        const std::int32_t base = group * kGemvGroupK + lane * 4;
+#pragma unroll
+        for (int t = 0; t < kT; ++t) {
+            if (t < tokens) {
+                const __nv_bfloat16* x_token =
+                    x + static_cast<std::int64_t>(t) * groups_per_row * kGemvGroupK;
+                const float2 low = __bfloat1622float2(
+                    *reinterpret_cast<const __nv_bfloat162*>(x_token + base));
+                const float2 high = __bfloat1622float2(
+                    *reinterpret_cast<const __nv_bfloat162*>(x_token + base + 2));
+                const float dot = fmaf(weight0, low.x,
+                                       fmaf(weight1, low.y, fmaf(weight2, high.x, weight3 * high.y)));
+                accumulator[t] = fmaf(scale, dot, accumulator[t]);
+            }
+        }
+    }
+
+#pragma unroll
+    for (int t = 0; t < kT; ++t) {
+        float value = accumulator[t];
+#pragma unroll
+        for (int offset = 16; offset > 0; offset >>= 1) {
+            value += __shfl_down_sync(0xffffffffu, value, offset);
+        }
+        if (lane == 0 && t < tokens) {
+            // Token-major output: element (row, token) lives at token * out_row_stride + row.
+            out[static_cast<std::int64_t>(t) * out_row_stride + warp] =
+                __float2bfloat16_rn(value);
+        }
+    }
+}
+
+} // namespace ninfer::ops::detail
diff --git a/src/ops/linear/ternary/ternary_rowsplit_storage.cuh b/src/ops/linear/ternary/ternary_rowsplit_storage.cuh
new file mode 100644
index 0000000..10d383b
--- /dev/null
+++ b/src/ops/linear/ternary/ternary_rowsplit_storage.cuh
@@ -0,0 +1,109 @@
+// MODIFIED for the NInfer ternary port (Ternary Bonsai 2 27B on NInfer / Ada sm_89).
+// This file differs from upstream NInfer; see patches/ in the release bundle
+// for the change list, rebuild steps and required verification.
+#pragma once
+
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+
+#include <cstdint>
+
+namespace ninfer::ops::detail {
+
+// Prism-private ternary weights, group 128, carried by NInfer's row-split-k128-v1 layout:
+//
+//   [ base plane ][ high plane ][ scale plane ]      scale = one binary16 per group
+//
+// PTQ1_0  base = qs[24]  base-3 trits, five per byte     high = qh[2], four per byte
+// PQ2_0   base = qs[32]  two-bit slots, four per byte    high = absent
+//
+// The split is not a reinterpretation: it is exactly how row_split_geometry() cuts a
+// payload for these formats (group_size 128, base 24/32, high 2/0, scale 2), and the
+// sizes it derives were checked byte for byte against the artifact reader
+// ([248320,5120] -> PTQ1_0 278,118,400 B / PQ2_0 337,715,200 B).
+
+struct PTQ1RowSplitStorage {
+    static constexpr int kGroupK             = 128;
+    static constexpr int kCodeBytesPerGroup  = 24;
+    static constexpr int kHighBytesPerGroup  = 2;
+    static constexpr int kScaleBytesPerGroup = 2;
+};
+
+struct PQ2RowSplitStorage {
+    static constexpr int kGroupK             = 128;
+    static constexpr int kCodeBytesPerGroup  = 32;
+    static constexpr int kHighBytesPerGroup  = 0;
+    static constexpr int kScaleBytesPerGroup = 2;
+};
+
+// 3^n for n in [0,5], as the table ggml's dequantizer reads. Kept as a branch chain so no
+// device-side array lookup is needed on the hot path.
+__device__ __forceinline__ constexpr std::uint8_t ternary_pow3(int n) {
+    return n <= 0 ? 1u : n == 1 ? 3u : n == 2 ? 9u : n == 3 ? 27u : n == 4 ? 81u : 243u;
+}
+
+__device__ __forceinline__ float ternary_scale(const std::uint8_t* scale_ptr) {
+    return __half2float(__ushort_as_half(*reinterpret_cast<const std::uint16_t*>(scale_ptr)));
+}
+
+// PQ2_0: block_pq2_0 { fp16 d; uint8 qs[32] } -> (code - 1) * d, code in {0,1,2}.
+// Per-weight form of dequantize_row_pq2_0 (ggml-quants.c). qs lives in the base plane.
+struct PQ2SimtDecodeAtom {
+    static constexpr int kGroupK = PQ2RowSplitStorage::kGroupK;
+
+    static __device__ __forceinline__ float load_scale(const std::uint8_t* scale_ptr) {
+        return ternary_scale(scale_ptr);
+    }
+
+    static __device__ __forceinline__ float decode_one(const std::uint8_t* codes,
+                                                       const std::uint8_t* high, float scale,
+                                                       int index) {
+        (void) high; // PQ2_0 stores no high plane; row_split_geometry reports 0 bytes for it
+        const int code = (static_cast<int>(codes[index >> 2]) >> (2 * (index & 3))) & 0x3;
+        return static_cast<float>(code - 1) * scale;
+    }
+};
+
+// PTQ1_0: block_ptq1_0 { uint8 qs[24]; uint8 qh[2]; fp16 d } with ptq1_0_stages {32,16,8}.
+//
+// Literal port of dequantize_row_ptq1_0. The stage walk matters and is not symmetric:
+// for a 24-byte qs the c=32 stage never runs (0 + 32 > 24), c=16 runs once and emits
+// weights 0..79 reading qs[0..15], c=8 runs once and emits weights 80..119 reading
+// qs[16..23]; the 2-byte qh then carries weights 120..127. That is 80 + 40 + 8 = 128.
+// Each trit is recovered as ((uint16)(q * 3^n) * 3) >> 8, with the uint8 wrap-around that
+// the C code relies on (`uint8_t q = qs[..] * pow3[n];` truncates on assignment).
+struct PTQ1SimtDecodeAtom {
+    static constexpr int kGroupK = PTQ1RowSplitStorage::kGroupK;
+
+    static __device__ __forceinline__ float load_scale(const std::uint8_t* scale_ptr) {
+        return ternary_scale(scale_ptr);
+    }
+
+    // qs lives in the base plane, qh in the high plane.
+    static __device__ __forceinline__ float decode_one(const std::uint8_t* codes,
+                                                       const std::uint8_t* high, float scale,
+                                                       int index) {
+        std::uint8_t raw;
+        int trit;
+        if (index < 80) {
+            // c = 16 stage: weights n*16 + m, byte qs[m]
+            trit = index >> 4;
+            raw  = codes[index & 15];
+        } else if (index < 120) {
+            // c = 8 stage: weights 80 + n*8 + m, byte qs[16 + m]
+            const int local = index - 80;
+            trit            = local >> 3;
+            raw             = codes[16 + (local & 7)];
+        } else {
+            // qh tail: weights 120 + n*2 + h, byte qh[h]
+            const int local = index - 120;
+            trit            = local >> 1;
+            raw             = high[local & 1];
+        }
+        const std::uint8_t q = static_cast<std::uint8_t>(raw * ternary_pow3(trit));
+        const int xi         = static_cast<int>((static_cast<std::uint16_t>(q) * 3u) >> 8);
+        return static_cast<float>(xi - 1) * scale;
+    }
+};
+
+} // namespace ninfer::ops::detail
diff --git a/src/ops/linear/ternary/v10_pack.cuh b/src/ops/linear/ternary/v10_pack.cuh
new file mode 100644
index 0000000..be3e9ff
--- /dev/null
+++ b/src/ops/linear/ternary/v10_pack.cuh
@@ -0,0 +1,33 @@
+#ifndef NINFER_TERNARY_V10_PACK_CUH
+#define NINFER_TERNARY_V10_PACK_CUH
+#include <cuda_fp16.h>
+#include <cuda_bf16.h>
+#include <cstdint>
+// Repack x[tokens][k] bf16 -> f16 in exact B-fragment order. Record for (token-tile of 8, 8-k block)
+// = 32 words = 8 tokens x 4 k-pairs; word (ti*4+c) holds halves k=2c,2c+1 of token tile*8+ti.
+// The GEMM then needs ONE coalesced 128B warp load per (tile,kt) per register, and no cvt.
+__global__ void ternary_pack_b_kernel(const __nv_bfloat16* __restrict__ x, __half* __restrict__ xp,
+                                      std::int32_t tokens, std::int32_t k, std::int64_t xrs) {
+    const int lane = threadIdx.x & 31;
+    const int warp = threadIdx.x >> 5;
+    const int kb = blockIdx.x * 4 + warp;
+    const int tile = blockIdx.y;
+    if (kb >= (k >> 3) || tile * 8 >= tokens) return;
+    const int ti = lane >> 2, c = lane & 3;
+    const int t = tile * 8 + ti;
+    __half2 h2 = __floats2half2_rn(0.f, 0.f);
+    if (t < tokens) {
+        const __nv_bfloat16* p = x + (std::int64_t)t * xrs + kb * 8 + c * 2;
+        const float2 f = __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(p));
+        h2 = __floats2half2_rn(f.x, f.y);
+    }
+    *reinterpret_cast<__half2*>(xp + ((std::int64_t)tile * (k >> 3) + kb) * 64 + (ti * 4 + c) * 2) = h2;
+}
+inline void launch_pack_b(const __nv_bfloat16* x, __half* xp, std::int32_t tokens, std::int32_t k,
+                          std::int64_t xrs, cudaStream_t stream) {
+    const std::int32_t tiles = (tokens + 7) >> 3;
+    const std::int32_t kb = k >> 3;
+    const dim3 grid((kb + 3) / 4, tiles, 1);
+    ternary_pack_b_kernel<<<grid, 128, 0, stream>>>(x, xp, tokens, k, xrs);
+}
+#endif
diff --git a/src/ops/linear/ternary/v2c_a.cuh b/src/ops/linear/ternary/v2c_a.cuh
new file mode 100644
index 0000000..fb54ede
--- /dev/null
+++ b/src/ops/linear/ternary/v2c_a.cuh
@@ -0,0 +1,33 @@
+// Chunked prefill kernel, v2c.
+//
+// Why: the row-tile kernel (v2) is launched once per 8 tokens because its n dimension is the mma n
+// (8). ncu on a prefill run shows every launch reading a whole weight matrix (5.68 MB for a
+// 4096x5120 layer) in 34 us = 166 GB/s, i.e. 18% of DRAM peak, to produce 8 tokens. A 3833-token
+// prompt therefore re-reads the entire 7.19 GB model 479 times (3.4 TB) and the bus sits idle 80%
+// of the time.
+//
+// v2c stages the block's whole-k code slab in shared memory once (16 rows x k/4 bytes; 20 KB at
+// k=5120) and then loops token tiles inside the block, so the weights are read once per block for
+// any number of tokens. The accumulator stays 4 registers: a tile's k sweep completes and is
+// written out before the next tile starts.
+//
+// Layout: one block = 16 rows x all k, 4 warps, no k split (a block owns its rows' weights
+// outright). Dispatch: tokens <= 8 -> v2 (better occupancy), tokens > 8 -> v2c.
+
+#pragma once
+
+namespace {
+
+constexpr int kV2cWarps    = 4;
+constexpr int kV2cRows     = 16;     // m
+constexpr int kV2cTok      = 8;      // mma n
+constexpr int kV2cGk       = 128;    // k per quantization group
+constexpr int kV2cKTiles   = kV2cGk / 16;
+constexpr int kV2cMinChunk = 16;   // the engine hands the mma path T = 30 per prefill call
+// 128 weights per group = 32 code bytes; 16 bytes of row padding keeps the 4-byte fragment loads
+// conflict free (row stride 1296 B = 324 words, 324 % 32 = 4, so the 8 fragment rows land on 8
+// distinct banks) and keeps every staging store 16-byte aligned.
+constexpr int kV2cCodeRow  = 1296;   // bytes of code per row (k/4 = 1280 + 16 pad)
+constexpr int kV2cGmax     = 64;     // groups staged per pass (64 * 128 = 8192 k)
+
+}  // namespace
diff --git a/src/ops/linear/ternary/v2c_b.cuh b/src/ops/linear/ternary/v2c_b.cuh
new file mode 100644
index 0000000..ea8f4f9
--- /dev/null
+++ b/src/ops/linear/ternary/v2c_b.cuh
@@ -0,0 +1,90 @@
+// v2c kernel body: stage the block's whole-k code slab once, then sweep token tiles inside the
+// block. Warps split the token dimension (warp w takes tiles w, w+4, w+8, ...), not k, because a
+// block owns its rows' weights outright - so the weights are read from DRAM exactly once per block
+// no matter how many tokens the launch carries.
+//
+//   smem layout: sc[16 rows][code_stride]  (code_stride is runtime, chosen so that code_stride % 128 == 16
+//   bytes: then the eight fragment rows land on eight distinct banks and the 4-byte fragment loads
+//   broadcast instead of conflicting)
+
+__global__ __launch_bounds__(kV2cWarps * 32)
+void ternary_pq2_mma_v2c_kernel(const std::uint8_t* __restrict__ codes,
+                                const std::uint8_t* __restrict__ scales,
+                                const __nv_bfloat16* __restrict__ x,
+                                __nv_bfloat16* __restrict__ out,
+                                std::int32_t rows, std::int32_t groups_per_row,
+                                std::int32_t tokens, std::int64_t x_row_stride,
+                                std::int64_t out_row_stride, std::int32_t code_stride) {
+    extern __shared__ std::uint8_t sc[];
+    const int lane = threadIdx.x & 31;
+    const int warp = threadIdx.x >> 5;
+    const int row_base = blockIdx.x * kV2cRows;
+    if (row_base >= rows) {
+        return;
+    }
+    const std::int32_t code_bytes = groups_per_row * 32;   // k / 4: the 2-bit codes of one row
+
+    // ---- stage every group of this block's 16 rows (once) ----
+    {
+        const int lrow = threadIdx.x >> 3;              // which row this lane helps copy (0..15)
+        const int lcol = (threadIdx.x & 7) * 16;        // 16-byte column slot inside a 128-byte block
+        const int r = row_base + lrow;
+        const std::uint8_t* src = codes + (std::int64_t)r * groups_per_row * 32;
+        std::uint8_t* dst = sc + (std::size_t)lrow * code_stride;
+        for (int off = 0; off < code_bytes; off += 128) {
+            const int o = off + lcol;
+            uint4 v = make_uint4(0u, 0u, 0u, 0u);
+            if (r < rows && o + 16 <= code_bytes) {
+                v = *reinterpret_cast<const uint4*>(src + o);
+            }
+            *reinterpret_cast<uint4*>(dst + o) = v;
+        }
+    }
+    __syncthreads();
+
+    // ---- sweep token tiles: warp w handles tiles w, w + kV2cWarps, ... ----
+    const int r0   = lane >> 2;          // fragment row 0..7 (rows +8 come from the second half)
+    const int cpar = lane & 3;           // column pair inside the k tile
+    const int tt   = r0;                 // fragment column = token inside the tile (n = 8)
+    const int hb   = cpar & 1;           // which 2-code half of the byte
+    const int bsel = (cpar >> 1) * 8;    // which byte of the 4-byte word
+
+    for (std::int32_t t0 = warp * kV2cTok; t0 < tokens; t0 += kV2cWarps * kV2cTok) {
+        float c[4] = {0.f, 0.f, 0.f, 0.f};
+        for (int g = 0; g < groups_per_row; ++g) {
+            const float s0 = v2_scale(scales, groups_per_row, row_base + r0, g);
+            const float s1 = v2_scale(scales, groups_per_row, row_base + r0 + 8, g);
+            const std::uint8_t* c0 = sc + (std::size_t)r0 * code_stride + g * 32;
+            const std::uint8_t* c1 = sc + (std::size_t)(r0 + 8) * code_stride + g * 32;
+            #pragma unroll
+            for (int kt = 0; kt < kV2cKTiles; ++kt) {
+                const std::uint32_t w0 = *reinterpret_cast<const std::uint32_t*>(c0 + kt * 4);
+                const std::uint32_t w1 = *reinterpret_cast<const std::uint32_t*>(c1 + kt * 4);
+                std::uint32_t a[4];
+                a[0] = v2_pair((w0 >> bsel) & 0xffu, hb, s0);
+                a[1] = v2_pair((w1 >> bsel) & 0xffu, hb, s1);
+                a[2] = v2_pair((w0 >> (bsel + 16)) & 0xffu, hb, s0);
+                a[3] = v2_pair((w1 >> (bsel + 16)) & 0xffu, hb, s1);
+                std::uint32_t b[2] = {0u, 0u};
+                const std::int32_t tg = t0 + tt;
+                if (tg < tokens) {
+                    const __nv_bfloat16* xb = x + (std::int64_t)tg * x_row_stride + g * kV2cGk + kt * 16 + cpar * 2;
+                    b[0] = *reinterpret_cast<const std::uint32_t*>(xb);
+                    b[1] = *reinterpret_cast<const std::uint32_t*>(xb + 8);
+                }
+                v2_mma_bf16(a[0], a[1], a[2], a[3], b[0], b[1], c);
+            }
+        }
+        // a block owns its rows, so no cross-warp reduction is needed - write straight out
+        const int ts = t0 + cpar * 2;
+        const int rr = row_base + r0;
+        if (rr < rows) {
+            if (ts < tokens)         out[(std::int64_t)ts * out_row_stride + rr]         = __float2bfloat16_rn(c[0]);
+            if (ts + 1 < tokens)     out[(std::int64_t)(ts + 1) * out_row_stride + rr]   = __float2bfloat16_rn(c[1]);
+        }
+        if (rr + 8 < rows) {
+            if (ts < tokens)         out[(std::int64_t)ts * out_row_stride + rr + 8]     = __float2bfloat16_rn(c[2]);
+            if (ts + 1 < tokens)     out[(std::int64_t)(ts + 1) * out_row_stride + rr + 8] = __float2bfloat16_rn(c[3]);
+        }
+    }
+}
diff --git a/src/ops/linear/ternary/v2c_c.cuh b/src/ops/linear/ternary/v2c_c.cuh
new file mode 100644
index 0000000..79382bb
--- /dev/null
+++ b/src/ops/linear/ternary/v2c_c.cuh
@@ -0,0 +1,39 @@
+// v2c launcher: ONE launch per token chunk. Dispatch sends chunks of >= kV2cMinChunk tokens here;
+// smaller T keeps the v2 row-tile kernel (it needs only 10 KB of smem, so its occupancy is better
+// and for 8..24 tokens the redundant weight re-reads are not yet the dominant cost).
+//
+// The smem slab is sized from runtime code_stride, so a k=5120 layer needs 16*1296 = 20.7 KB
+// (4 blocks/SM) while a k=17408 down_proj needs 16*4368 = 69.9 KB (1 block/SM, still DRAM-bound
+// because the staging copies are 16 B x 128 lanes deep).
+
+inline void launch_pq2_mma_v2c(const std::uint8_t* codes,
+                               const std::uint8_t* scales,
+                               const __nv_bfloat16* x,
+                               __nv_bfloat16* out,
+                               std::int32_t rows,
+                               std::int32_t groups_per_row,
+                               std::int32_t tokens,
+                               std::int64_t x_row_stride,
+                               std::int64_t out_row_stride,
+                               cudaStream_t stream) {
+    const std::int32_t code_bytes = groups_per_row * 32;
+    std::int32_t code_stride = ((code_bytes + 15) / 16) * 16;
+    while (code_stride % 128 != 16) {
+        code_stride += 16;
+    }
+    const std::size_t smem_bytes =
+        static_cast<std::size_t>(kV2cRows) * static_cast<std::size_t>(code_stride);
+
+    static std::size_t configured_smem = 0;
+    if (smem_bytes > configured_smem) {
+        cudaFuncSetAttribute(ternary_pq2_mma_v2c_kernel,
+                             cudaFuncAttributeMaxDynamicSharedMemorySize,
+                             static_cast<int>(smem_bytes));
+        configured_smem = smem_bytes;
+    }
+
+    const std::int32_t blocks = (rows + kV2cRows - 1) / kV2cRows;
+    ternary_pq2_mma_v2c_kernel<<<blocks, kV2cWarps * 32, smem_bytes, stream>>>(
+        codes, scales, x, out, rows, groups_per_row, tokens,
+        x_row_stride, out_row_stride, code_stride);
+}
diff --git a/src/ops/linear/ternary/v3_a.cuh b/src/ops/linear/ternary/v3_a.cuh
new file mode 100644
index 0000000..b79d012
--- /dev/null
+++ b/src/ops/linear/ternary/v3_a.cuh
@@ -0,0 +1,32 @@
+#ifndef NINFER_TERNARY_V3_A_CUH
+#define NINFER_TERNARY_V3_A_CUH
+// v3: prefill-shaped ternary mma.
+//
+// v2 rebuilds the tensor-core A fragments from the packed 2-bit codes once per 8-token tile, so a
+// 30-token call decodes every weight of the block FOUR times before any mma sees it. Measured on a
+// 4640-token prompt that costs the bulk of the time: the 8-token launcher loop re-reading weights
+// was worth only +34%, so the decode/dependency chain, not DRAM traffic, is the limit.
+//
+// v3 decodes one whole k-group of the block's rows ONCE into shared memory, with the group scale
+// already folded in, and then lets every token tile read its A fragments straight out of the slab.
+//
+// Block = 16 rows x 32 tokens. The four warps split the TOKEN window (warp w owns tokens
+// w*8 .. w*8+7), not k, because the slab covers all k for the block's rows: no k-split, no partial
+// sums, no cross-warp reduction, and one decode serves four tiles.
+
+constexpr int kV3Warps = 4;
+constexpr int kV3Rows  = 16;
+constexpr int kV3Cols  = 32;   // token window per block
+constexpr int kV3Tok   = 8;    // tokens per warp == mma n
+constexpr int kV3Gk    = 128;  // weights per quantization group
+constexpr int kV3KTiles = kV3Gk / 16;
+
+// Slab row stride, in bf16 elements: 128 weights plus 8 of padding. 136 elements is 68 words, and
+// 68 % 32 == 4, so the 32 lanes of one A-fragment load (r0*4 + cpar for lane = r0*4 + cpar) spread
+// over all 32 shared-memory banks instead of piling onto one.
+constexpr int kV3SlabStride = kV3Gk + 8;
+
+// The engine hands the mma path T = 30 tokens per prefill call, so anything at or above this uses
+// v3; the MTP verify pass (T = 5) and single-token decode stay on v2.
+constexpr int kV3MinChunk = 512;  // only real prefill chunks use v3; below that v2c is proven
+#endif  // NINFER_TERNARY_V3_A_CUH
diff --git a/src/ops/linear/ternary/v3_b.cuh b/src/ops/linear/ternary/v3_b.cuh
new file mode 100644
index 0000000..5ee0953
--- /dev/null
+++ b/src/ops/linear/ternary/v3_b.cuh
@@ -0,0 +1,98 @@
+#ifndef NINFER_TERNARY_V3_B_CUH
+#define NINFER_TERNARY_V3_B_CUH
+// v3 prefill kernel: one CTA is 16 rows x kV3Cols tokens (4 warps x kV3Tok tokens each), and each
+// k-group's weights are decoded into shared memory ONCE per CTA, so every token tile reads its A
+// fragment out of that slab instead of re-decoding the codes.
+//
+// CONVERGENCE RULE (this bit us): the kernel body inside the group loop must contain NO predicated
+// region that wraps a __syncthreads(). An earlier revision guarded the whole k-tile loop with
+// `if (tok < tokens)`; that is uniform for full CTAs but lane-divergent in the last CTA whenever
+// tokens is not a multiple of kV3Cols, and the barrier then deadlocked (a launch with tokens=1050
+// hung forever, 1056 was fine). All reads are now clamped to legal indices and only the final store
+// is predicated, which sits far away from any barrier.
+// The includer must have brought in v3_a.cuh and ternary_mma_v2.cuh already: both define
+// namespace-scope constants and neither carries an include guard, so including them here as well
+// makes the engine's unity build fail with "has already been defined".
+
+// The engine's unity build includes this inside ni::ops::detail, and the microbench includes it at
+// global scope: this file must NOT open a namespace of its own, or the kernel lands one level too
+// deep and the launcher in v3_c.cuh cannot see it.
+
+__global__ __launch_bounds__(kV3Warps * 32) void ternary_pq2_mma_v3_kernel(
+        const std::uint8_t* __restrict__ codes, const std::uint8_t* __restrict__ scales,
+        const __nv_bfloat16* __restrict__ x, __nv_bfloat16* __restrict__ dst, int rows,
+        int groups_per_row, int tokens, int x_row_stride, int out_row_stride) {
+    __shared__ __nv_bfloat16 slab[kV3Rows * kV3SlabStride];
+    __shared__ std::uint8_t raw[kV3Rows * 32];
+
+    const int tid = threadIdx.x;
+    const int warp = tid >> 5;
+    const int lane = tid & 31;
+    const int r0 = lane >> 2;
+    const int cpar = lane & 3;
+    const int row_base = blockIdx.x * kV3Rows;
+    const int tok_base = blockIdx.y * kV3Cols;
+    const int last_row = (rows > 0) ? (rows - 1) : 0;
+    const int last_tok = (tokens > 0) ? (tokens - 1) : 0;
+    // clamped token for this lane's activation reads
+    const int tok = min(tok_base + warp * kV3Tok + r0, last_tok);
+
+    float c[4] = {0.f, 0.f, 0.f, 0.f};
+
+    for (int g = 0; g < groups_per_row; ++g) {
+        __syncthreads();
+        // 1) stage this group's raw codes for this CTA's 16 rows (16 x 32 bytes, one byte per thread)
+        {
+            const int srow = tid >> 3;
+            const int soff = (tid & 7) * 4;
+            const int sr = min(row_base + srow, last_row);
+            const std::uint8_t* p = codes + ((std::int64_t)sr * groups_per_row + g) * 32 + soff;
+            const std::uint32_t v = (std::uint32_t)p[0] | ((std::uint32_t)p[1] << 8) |
+                                    ((std::uint32_t)p[2] << 16) | ((std::uint32_t)p[3] << 24);
+            reinterpret_cast<std::uint32_t*>(raw)[tid] = v;
+        }
+        // 2) decode it into the slab once, group scale folded in (128 weights per row)
+        {
+            const int dr = tid >> 3;
+            const int dj = tid & 7;
+            const float s = v2_scale(scales, groups_per_row, min(row_base + dr, last_row), g);
+            const std::uint8_t* rb = raw + dr * 32 + dj * 4;
+            std::uint32_t* d4 = reinterpret_cast<std::uint32_t*>(slab + dr * kV3SlabStride + dj * 16);
+            for (int b = 0; b < 4; ++b) {
+                d4[b * 2 + 0] = v2_pair(rb[b], 0, s);
+                d4[b * 2 + 1] = v2_pair(rb[b], 1, s);
+            }
+        }
+        __syncthreads();
+        // 3) consume: unconditional, so the barriers above are always reached by every thread
+        const __nv_bfloat16* xb = x + (std::int64_t)tok * x_row_stride + g * kV3Gk + cpar * 2;
+        const __nv_bfloat16* ar = slab + r0 * kV3SlabStride + cpar * 2;
+        const __nv_bfloat16* ar8 = ar + 8 * kV3SlabStride;
+        for (int kt = 0; kt < kV3KTiles; ++kt) {
+            const int kk = kt * 16;
+            const std::uint32_t a0 = *reinterpret_cast<const std::uint32_t*>(ar + kk);
+            const std::uint32_t a1 = *reinterpret_cast<const std::uint32_t*>(ar8 + kk);
+            const std::uint32_t a2 = *reinterpret_cast<const std::uint32_t*>(ar + kk + 8);
+            const std::uint32_t a3 = *reinterpret_cast<const std::uint32_t*>(ar8 + kk + 8);
+            const std::uint32_t b0 = *reinterpret_cast<const std::uint32_t*>(xb + kk);
+            const std::uint32_t b1 = *reinterpret_cast<const std::uint32_t*>(xb + kk + 8);
+            v2_mma_bf16(a0, a1, a2, a3, b0, b1, c);
+        }
+    }
+
+    // 4) store the accumulators; predicated, but far from any barrier
+    const int t0 = tok_base + warp * kV3Tok + cpar * 2;
+    const int t1 = t0 + 1;
+    const int r_lo = row_base + r0;
+    const int r_hi = row_base + r0 + 8;
+    if (r_lo < rows) {
+        if (t0 < tokens) dst[(std::int64_t)t0 * out_row_stride + r_lo] = __float2bfloat16_rn(c[0]);
+        if (t1 < tokens) dst[(std::int64_t)t1 * out_row_stride + r_lo] = __float2bfloat16_rn(c[1]);
+    }
+    if (r_hi < rows) {
+        if (t0 < tokens) dst[(std::int64_t)t0 * out_row_stride + r_hi] = __float2bfloat16_rn(c[2]);
+        if (t1 < tokens) dst[(std::int64_t)t1 * out_row_stride + r_hi] = __float2bfloat16_rn(c[3]);
+    }
+}
+
+#endif  // NINFER_TERNARY_V3_B_CUH
diff --git a/src/ops/linear/ternary/v3_c.cuh b/src/ops/linear/ternary/v3_c.cuh
new file mode 100644
index 0000000..a598eef
--- /dev/null
+++ b/src/ops/linear/ternary/v3_c.cuh
@@ -0,0 +1,20 @@
+// v3 launcher: one launch covers the block grid (row tiles x token windows). Unlike the v2 entry
+// there is no 8-token stepping loop, so the block's rows are read and decoded once per group and
+// every token tile in the window reuses that slab.
+
+#include "v3_b.cuh"  // guarded, so it is safe if the unity build already pulled it in
+
+inline void launch_pq2_mma_v3(const std::uint8_t* codes,
+                              const std::uint8_t* scales,
+                              const __nv_bfloat16* x,
+                              __nv_bfloat16* out,
+                              std::int32_t rows,
+                              std::int32_t groups_per_row,
+                              std::int32_t tokens,
+                              std::int64_t x_row_stride,
+                              std::int64_t out_row_stride,
+                              cudaStream_t stream) {
+    const dim3 grid((rows + kV3Rows - 1) / kV3Rows, (tokens + kV3Cols - 1) / kV3Cols, 1);
+    ternary_pq2_mma_v3_kernel<<<grid, kV3Warps * 32, 0, stream>>>(
+        codes, scales, x, out, rows, groups_per_row, tokens, x_row_stride, out_row_stride);
+}
diff --git a/src/ops/linear/ternary/v4_a.cuh b/src/ops/linear/ternary/v4_a.cuh
new file mode 100644
index 0000000..0b270d1
--- /dev/null
+++ b/src/ops/linear/ternary/v4_a.cuh
@@ -0,0 +1,25 @@
+#ifndef NINFER_TERNARY_V4_A_CUH
+#define NINFER_TERNARY_V4_A_CUH
+// v4: same "decode one k-group into a slab, let every token tile read the A fragments from it"
+// shape as v3, but each warp owns kV4TilesPerWarp 8-token mma tiles instead of just one, so a CTA
+// covers 16 rows x 128 tokens instead of 16 x 32.
+//
+// Why: v3 amortizes the weight decode over only 32 tokens, which is the "CTA count is the decisive
+// variable" trap from the upstream write-up. Widening to 128 divides both the decode work and the
+// CTA count by four. The accumulators stay in registers (c[kV4TilesPerWarp][4] = 16 floats per
+// thread) -- putting them in shared memory instead would add roughly eight shared-memory
+// operations per mma and make shared bandwidth the new wall.
+//
+// The inner loop also hoists the four A fragment loads out of the tile loop: the A operand is the
+// *weight*, identical for every token, so one load now feeds kV4TilesPerWarp mmas (3 shared-memory
+// ops per mma against v3's 6).
+constexpr int kV4Warps = 4;
+constexpr int kV4Rows  = 16;
+constexpr int kV4Tok   = 8;                          // tokens per tile == mma n
+constexpr int kV4TilesPerWarp = 8;                   // 8-token tiles each warp walks
+constexpr int kV4Cols  = kV4Warps * kV4TilesPerWarp * kV4Tok;   // token window per CTA = 128
+constexpr int kV4Gk    = 128;                        // weights per quantization group
+constexpr int kV4KTiles = kV4Gk / 16;                // 16-k mma steps per group
+constexpr int kV4SlabStride = kV4Gk + 8;
+constexpr int kV4MinChunk = 512;                     // only real prefill chunks
+#endif  // NINFER_TERNARY_V4_A_CUH
diff --git a/src/ops/linear/ternary/v4_b.cuh b/src/ops/linear/ternary/v4_b.cuh
new file mode 100644
index 0000000..ac0d455
--- /dev/null
+++ b/src/ops/linear/ternary/v4_b.cuh
@@ -0,0 +1,97 @@
+#ifndef NINFER_TERNARY_V4_B_CUH
+#define NINFER_TERNARY_V4_B_CUH
+// v4 kernel: 16 rows x 128 tokens per CTA, 4 warps x 4 eight-token tiles each. Every read is clamped
+// to a legal index and only the final store is predicated, so no barrier can land inside divergent
+// code -- the bug that made v3 deadlock whenever tokens %% kV4Cols != 0 (the engine passes 4636).
+// The A operand is the weight, so its four fragment loads are hoisted out of the tile loop and feed
+// all kV4TilesPerWarp mmas. The includer supplies v4_a.cuh and ternary_mma_v2.cuh; this file opens
+// no namespace of its own (the engine's unity build includes it inside ni::ops::detail).
+
+__global__ __launch_bounds__(kV4Warps * 32) void ternary_pq2_mma_v4_kernel(
+        const std::uint8_t* __restrict__ codes,
+        const std::uint8_t* __restrict__ scales,
+        const __nv_bfloat16* __restrict__ x,
+        __nv_bfloat16* __restrict__ dst,
+        int rows, int groups_per_row, int tokens, int x_row_stride, int out_row_stride) {
+    __shared__ __nv_bfloat16 slab[kV4Rows * kV4SlabStride];
+    __shared__ std::uint8_t raw[kV4Rows * 32];
+
+    const int tid = threadIdx.x;
+    const int warp = tid >> 5;
+    const int lane = tid & 31;
+    const int r0 = lane >> 2;
+    const int cpar = lane & 3;
+    const int row_base = blockIdx.x * kV4Rows;
+    const int tok_base = blockIdx.y * kV4Cols;
+    const int last_row = (rows > 0) ? (rows - 1) : 0;
+    const int last_tok = (tokens > 0) ? (tokens - 1) : 0;
+
+    float c[kV4TilesPerWarp][4];
+    int tokc[kV4TilesPerWarp];
+#pragma unroll
+    for (int t = 0; t < kV4TilesPerWarp; ++t) {
+        c[t][0] = c[t][1] = c[t][2] = c[t][3] = 0.f;
+        tokc[t] = min(tok_base + (warp * kV4TilesPerWarp + t) * kV4Tok + r0, last_tok);
+    }
+
+    for (int g = 0; g < groups_per_row; ++g) {
+        __syncthreads();
+        {   // stage this group's packed codes for the CTA's 16 rows
+            const int srow = tid >> 3;
+            const int soff = (tid & 7) * 4;
+            const int sr = min(row_base + srow, last_row);
+            const std::uint8_t* p = codes + ((std::int64_t)sr * groups_per_row + g) * 32 + soff;
+            const std::uint32_t v = (std::uint32_t)p[0] | ((std::uint32_t)p[1] << 8) |
+                                    ((std::uint32_t)p[2] << 16) | ((std::uint32_t)p[3] << 24);
+            reinterpret_cast<std::uint32_t*>(raw)[tid] = v;
+        }
+        {   // decode the group once, scale already folded in
+            const int dr = tid >> 3;
+            const int dj = tid & 7;
+            const int sr = min(row_base + dr, last_row);
+            const float s = v2_scale(scales, groups_per_row, sr, g);
+            const std::uint8_t* rb = raw + dr * 32 + dj * 4;
+            std::uint32_t* d4 = reinterpret_cast<std::uint32_t*>(slab + dr * kV4SlabStride + dj * 16);
+#pragma unroll
+            for (int b = 0; b < 4; ++b) {
+                d4[b * 2 + 0] = v2_pair(rb[b], 0, s);
+                d4[b * 2 + 1] = v2_pair(rb[b], 1, s);
+            }
+        }
+        __syncthreads();
+
+        const __nv_bfloat16* ar = slab + r0 * kV4SlabStride + cpar * 2;
+        const __nv_bfloat16* ar8 = ar + 8 * kV4SlabStride;
+        for (int kt = 0; kt < kV4KTiles; ++kt) {
+            const int kk = kt * 16;
+            const std::uint32_t a0 = *reinterpret_cast<const std::uint32_t*>(ar + kk);
+            const std::uint32_t a1 = *reinterpret_cast<const std::uint32_t*>(ar8 + kk);
+            const std::uint32_t a2 = *reinterpret_cast<const std::uint32_t*>(ar + kk + 8);
+            const std::uint32_t a3 = *reinterpret_cast<const std::uint32_t*>(ar8 + kk + 8);
+#pragma unroll
+            for (int t = 0; t < kV4TilesPerWarp; ++t) {
+                const __nv_bfloat16* xb = x + (std::int64_t)tokc[t] * x_row_stride + g * kV4Gk + cpar * 2 + kk;
+                const std::uint32_t b0 = *reinterpret_cast<const std::uint32_t*>(xb);
+                const std::uint32_t b1 = *reinterpret_cast<const std::uint32_t*>(xb + 8);
+                v2_mma_bf16(a0, a1, a2, a3, b0, b1, c[t]);
+            }
+        }
+    }
+
+#pragma unroll
+    for (int t = 0; t < kV4TilesPerWarp; ++t) {
+        const int r_lo = row_base + r0;
+        const int r_hi = row_base + r0 + 8;
+        const int t0 = tok_base + (warp * kV4TilesPerWarp + t) * kV4Tok + cpar * 2;
+        const int t1 = t0 + 1;
+        if (r_lo < rows) {
+            if (t0 < tokens) dst[(std::int64_t)t0 * out_row_stride + r_lo] = __float2bfloat16_rn(c[t][0]);
+            if (t1 < tokens) dst[(std::int64_t)t1 * out_row_stride + r_lo] = __float2bfloat16_rn(c[t][1]);
+        }
+        if (r_hi < rows) {
+            if (t0 < tokens) dst[(std::int64_t)t0 * out_row_stride + r_hi] = __float2bfloat16_rn(c[t][2]);
+            if (t1 < tokens) dst[(std::int64_t)t1 * out_row_stride + r_hi] = __float2bfloat16_rn(c[t][3]);
+        }
+    }
+}
+#endif  // NINFER_TERNARY_V4_B_CUH
diff --git a/src/ops/linear/ternary/v4_c.cuh b/src/ops/linear/ternary/v4_c.cuh
