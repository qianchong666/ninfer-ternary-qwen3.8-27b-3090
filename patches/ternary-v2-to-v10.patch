+    HadamardSignsPlan plan;
+    plan.values = artifact::bind_device_tensor(binder, "text/hadamard_signs", NumericFormat::FP32,
+                                               {kHadamardSignValues});
+    plan.widths = artifact::bind_tensor(binder, "text/hadamard_widths", NumericFormat::I32,
+                                        {kHadamardWidthCount},
