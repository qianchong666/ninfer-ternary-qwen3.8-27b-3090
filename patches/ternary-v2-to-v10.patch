+            if (fabs(dd) > mx9) mx9 = fabs(dd);
+            if (b9[i] != b4y[i]) ++d9;
+        }
+        printf("v9 vs v4: rel_l2 %.3e   max|diff| %.4f   %zu of %zu differ\n",
+               std::sqrt(nu9 / (de9 + 1e-30)), mx9, d9, n9);
+    }
+
+    return 0;
+}
