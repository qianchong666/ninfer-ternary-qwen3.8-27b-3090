+    printf("CUDA error %s at line %d\n", cudaGetErrorString(e_), __LINE__); exit(1); } } while (0)
+
+__global__ void ref_kernel(const std::uint8_t* __restrict__ codes, const __half* __restrict__ scales,
+                           const __nv_bfloat16* __restrict__ x, __nv_bfloat16* __restrict__ out,
+                           int rows, int groups_per_row, std::int64_t out_row_stride) {
+    const std::int64_t idx = blockIdx.x * (std::int64_t)blockDim.x + threadIdx.x;
+    if (idx >= rows) return;
+    const int r = (int)idx;
+    float acc = 0.f;
+    for (int g = 0; g < groups_per_row; ++g) {
+        const std::uint8_t* cp = codes + ((std::int64_t)r * groups_per_row + g) * 32;
+        const float s = __half2float(scales[(std::int64_t)r * groups_per_row + g]);
+        for (int b = 0; b < 32; ++b) {
+            const std::uint8_t byte = cp[b];
+            for (int i = 0; i < 4; ++i) {
+                const int code = (byte >> (2 * i)) & 3;
+                // v2_pair rounds each weight to bf16 before the mma, so mirror that exactly.
+                const float w = __bfloat162float(__float2bfloat16_rn((float)(code - 1) * s));
+                acc += w * __bfloat162float(x[g * 128 + b * 4 + i]);
+            }
+        }
+    }
+    out[r] = __float2bfloat16_rn(acc);
+}
+
+int main(int argc, char** argv) {
+    int rows = (argc > 1) ? atoi(argv[1]) : 512;
+    int groups = (argc > 2) ? atoi(argv[2]) : 8;
+    int tokens = (argc > 3) ? atoi(argv[3]) : 128;
+    int reps = (argc > 4) ? atoi(argv[4]) : 20;
+    const int k = groups * 128;
+    printf("rows=%d groups=%d k=%d tokens=%d reps=%d\n", rows, groups, k, tokens, reps);
+
+    std::vector<std::uint8_t> h_codes((std::size_t)rows * groups * 32);
+    std::vector<__half> h_scales((std::size_t)rows * groups);
+    std::vector<__nv_bfloat16> h_x((std::size_t)tokens * k);
+    for (auto& v : h_codes) v = (std::uint8_t)(rand() & 0xff);
+    for (auto& v : h_scales) v = __float2half(0.25f + (rand() % 16) * 0.25f);
+    for (auto& v : h_x) v = __float2bfloat16_rn(((rand() / (float)RAND_MAX) - 0.5f) * 2.f);
+
+    std::uint8_t* d_codes; __half* d_scales; __nv_bfloat16 *d_x, *d_out, *d_ref;
+    CK(cudaMalloc(&d_codes, h_codes.size()));
+    CK(cudaMalloc(&d_scales, h_scales.size() * sizeof(__half)));
+    CK(cudaMalloc(&d_x, h_x.size() * sizeof(__nv_bfloat16)));
+    CK(cudaMalloc(&d_out, (std::size_t)tokens * rows * sizeof(__nv_bfloat16)));
+    CK(cudaMalloc(&d_ref, (std::size_t)tokens * rows * sizeof(__nv_bfloat16)));
+    CK(cudaMemcpy(d_codes, h_codes.data(), h_codes.size(), cudaMemcpyHostToDevice));
+    CK(cudaMemcpy(d_scales, h_scales.data(), h_scales.size() * sizeof(__half), cudaMemcpyHostToDevice));
+    CK(cudaMemcpy(d_x, h_x.data(), h_x.size() * sizeof(__nv_bfloat16), cudaMemcpyHostToDevice));
+
+    const int ref_tokens = (tokens > 256) ? 4 : tokens;
+    for (int i = 0; i < ref_tokens; ++i) {
+        const std::int64_t t0 = ((std::int64_t)i * 97) % tokens;
+        ref_kernel<<<(int)((rows + 255) / 256), 256>>>(d_codes, d_scales, d_x + t0 * k,
+                                                      d_ref + t0 * rows, rows, groups, rows);
+    }
+    CK(cudaDeviceSynchronize());
+    fprintf(stderr, "[mb] phase1 ref done\n"); fflush(stderr);
+
+    cudaEvent_t e0, e1; CK(cudaEventCreate(&e0)); CK(cudaEventCreate(&e1));
+    CK(cudaEventRecord(e0));
+    for (int i = 0; i < reps; ++i) {
+        launch_pq2_mma_v3(d_codes, reinterpret_cast<const std::uint8_t*>(d_scales), d_x, d_out, rows, groups, tokens, k, rows, 0);
+    }
+    CK(cudaEventRecord(e1)); CK(cudaEventSynchronize(e1));
+    float ms = 0.f; CK(cudaEventElapsedTime(&ms, e0, e1)); ms /= reps;
+    const double flop = 2.0 * rows * (double)tokens * k;
+    printf("v3  %.3f ms   %.1f tok/s   %.1f TFLOPS\n", ms, tokens / (ms / 1000.0), flop / (ms / 1000.0) / 1e12);
+
+    fprintf(stderr, "[mb] phase2 timing done\n"); fflush(stderr);
+    launch_pq2_mma_v3(d_codes, reinterpret_cast<const std::uint8_t*>(d_scales), d_x, d_out, rows, groups, tokens, k, rows, 0);
+    CK(cudaGetLastError()); CK(cudaDeviceSynchronize());
+    fprintf(stderr, "[mb] phase3 check done\n"); fflush(stderr);
+    std::vector<__nv_bfloat16> h_out((std::size_t)rows), h_r((std::size_t)rows);
+    double num = 0, den = 0;
+    for (int i = 0; i < ref_tokens; ++i) {
+        const std::int64_t t0 = ((std::int64_t)i * 97) % tokens;
+        CK(cudaMemcpy(h_out.data(), d_out + t0 * rows, rows * sizeof(__nv_bfloat16), cudaMemcpyDeviceToHost));
+        CK(cudaMemcpy(h_r.data(), d_ref + t0 * rows, rows * sizeof(__nv_bfloat16), cudaMemcpyDeviceToHost));
+        for (int r = 0; r < rows; ++r) {
+            const double a = __bfloat162float(h_out[r]), b = __bfloat162float(h_r[r]);
+            num += (a - b) * (a - b); den += b * b;
+        }
+    }
+    printf("rel_l2 = %.3e over %d sampled tokens\n", std::sqrt(num / (den + 1e-30)), ref_tokens);
+
+    // v4: timed, then compared element-by-element against v3's output
+    cudaEvent_t f0, f1; CK(cudaEventCreate(&f0)); CK(cudaEventCreate(&f1));
+    CK(cudaEventRecord(f0));
+    for (int i = 0; i < reps; ++i) {
+        launch_pq2_mma_v4(d_codes, reinterpret_cast<const std::uint8_t*>(d_scales), d_x, d_ref, rows, groups, tokens, k, rows, 0);
+    }
+    CK(cudaEventRecord(f1)); CK(cudaEventSynchronize(f1));
+    float ms4 = 0.f; CK(cudaEventElapsedTime(&ms4, f0, f1)); if (reps > 0) ms4 /= reps;
+    printf("v4  %.3f ms   prefill %.1f tok/s   %.1f TFLOPS\n", ms4, tokens / (ms4 / 1000.0), flop / (ms4 / 1000.0) / 1e12);
+    {
+        const std::size_t n = (std::size_t)tokens * rows;
+        std::vector<__nv_bfloat16> ha(n), hb(n);
+        CK(cudaMemcpy(ha.data(), d_out, n * sizeof(__nv_bfloat16), cudaMemcpyDeviceToHost));
+        CK(cudaMemcpy(hb.data(), d_ref, n * sizeof(__nv_bfloat16), cudaMemcpyDeviceToHost));
+        std::size_t diff = 0;
+        for (std::size_t i = 0; i < n; ++i) if (ha[i] != hb[i]) ++diff;
+        printf("v4 vs v3: %zu of %zu elements differ\n", diff, n);
+    }
+
+    // v5: f16 inputs with a split f16 accumulator (2x the mma rate), timed and compared to v4
+    {
+        cudaEvent_t g0, g1; CK(cudaEventCreate(&g0)); CK(cudaEventCreate(&g1));
+        CK(cudaEventRecord(g0));
+        for (int i = 0; i < reps; ++i) {
+            launch_pq2_mma_v5(d_codes, reinterpret_cast<const std::uint8_t*>(d_scales), d_x, d_out, rows, groups, tokens, k, rows, 0);
+        }
+        CK(cudaEventRecord(g1)); CK(cudaEventSynchronize(g1));
+        float ms5 = 0.f; CK(cudaEventElapsedTime(&ms5, g0, g1)); ms5 /= reps;
+        printf("v5  %.3f ms   prefill %.1f tok/s   %.1f TFLOPS\n", ms5, tokens / (ms5 / 1000.0), flop / (ms5 / 1000.0) / 1e12);
+        CK(cudaGetLastError());
+        const std::size_t n = (std::size_t)tokens * rows;
+        std::vector<__nv_bfloat16> a5(n), a4(n);
+        CK(cudaMemcpy(a5.data(), d_out, n * sizeof(__nv_bfloat16), cudaMemcpyDeviceToHost));
+        CK(cudaMemcpy(a4.data(), d_ref, n * sizeof(__nv_bfloat16), cudaMemcpyDeviceToHost));
+        double num5 = 0, den5 = 0, mx = 0; std::size_t diff5 = 0;
+        for (std::size_t i = 0; i < n; ++i) {
+            const double x5 = __bfloat162float(a5[i]), x4 = __bfloat162float(a4[i]);
+            const double dd = x5 - x4;
+            num5 += dd * dd; den5 += x4 * x4;
+            if (fabs(dd) > mx) mx = fabs(dd);
+            if (a5[i] != a4[i]) ++diff5;
+        }
+        printf("v5 vs v4: rel_l2 %.3e   max|diff| %.4f   %zu of %zu differ\n",
+               std::sqrt(num5 / (den5 + 1e-30)), mx, diff5, n);
+    }
+    // v5 with the in-loop B conversion removed: garbage numbers, identical memory traffic, so this
+    // isolates what the bf16->f16 conversion inside the tile loop actually costs
+    {
+        cudaEvent_t h0, h1; CK(cudaEventCreate(&h0)); CK(cudaEventCreate(&h1));
+        CK(cudaEventRecord(h0));
+        for (int i = 0; i < reps; ++i) {
+            launch_pq2_mma_v5_noconv(d_codes, reinterpret_cast<const std::uint8_t*>(d_scales), d_x, d_out, rows, groups, tokens, k, rows, 0);
+        }
+        CK(cudaEventRecord(h1)); CK(cudaEventSynchronize(h1));
+        float msn = 0.f; CK(cudaEventElapsedTime(&msn, h0, h1)); msn /= reps;
+        printf("v5n %.3f ms   %.1f tok/s   %.1f TFLOPS   (no B conversion)\n", msn,
+               tokens / (msn / 1000.0), flop / (msn / 1000.0) / 1e12);
+    }
+
+    // v6: v4's tiling with a pipelined staging load (cp.async prefetch of the next group)
+    {
+        cudaEvent_t k0, k1; CK(cudaEventCreate(&k0)); CK(cudaEventCreate(&k1));
+        CK(cudaEventRecord(k0));
+        for (int i = 0; i < reps; ++i) {
+            launch_pq2_mma_v6(d_codes, reinterpret_cast<const std::uint8_t*>(d_scales), d_x, d_out, rows, groups, tokens, k, rows, 0);
+        }
+        CK(cudaEventRecord(k1)); CK(cudaEventSynchronize(k1));
+        float ms6 = 0.f; CK(cudaEventElapsedTime(&ms6, k0, k1)); ms6 /= reps;
+        printf("v6  %.3f ms   %.1f tok/s   %.1f TFLOPS\n", ms6, tokens / (ms6 / 1000.0), flop / (ms6 / 1000.0) / 1e12);
+        const std::size_t n6 = (std::size_t)tokens * rows;
+        std::vector<__nv_bfloat16> a6(n6), a4b(n6);
+        CK(cudaMemcpy(a6.data(), d_out, n6 * sizeof(__nv_bfloat16), cudaMemcpyDeviceToHost));
+        CK(cudaMemcpy(a4b.data(), d_ref, n6 * sizeof(__nv_bfloat16), cudaMemcpyDeviceToHost));
+        std::size_t df = 0;
+        for (std::size_t i = 0; i < n6; ++i) if (a6[i] != a4b[i]) ++df;
+        printf("v6 vs v4: %zu of %zu elements differ\n", df, n6);
+    }
+
+    // v7: 32-row CTAs, two 16-row groups per warp sharing the activation registers
+    {
+        cudaEvent_t p0, p1; CK(cudaEventCreate(&p0)); CK(cudaEventCreate(&p1));
+        CK(cudaEventRecord(p0));
+        for (int i = 0; i < reps; ++i) {
+            launch_pq2_mma_v7(d_codes, reinterpret_cast<const std::uint8_t*>(d_scales), d_x, d_out, rows, groups, tokens, k, rows, 0);
+        }
+        CK(cudaEventRecord(p1)); CK(cudaEventSynchronize(p1));
+        float ms7 = 0.f; CK(cudaEventElapsedTime(&ms7, p0, p1)); ms7 /= reps;
+        printf("v7  %.3f ms   %.1f tok/s   %.1f TFLOPS\n", ms7, tokens / (ms7 / 1000.0), flop / (ms7 / 1000.0) / 1e12);
+        const std::size_t n7 = (std::size_t)tokens * rows;
+        std::vector<__nv_bfloat16> a7(n7), a4c(n7);
+        CK(cudaMemcpy(a7.data(), d_out, n7 * sizeof(__nv_bfloat16), cudaMemcpyDeviceToHost));
+        CK(cudaMemcpy(a4c.data(), d_ref, n7 * sizeof(__nv_bfloat16), cudaMemcpyDeviceToHost));
+        std::size_t d7 = 0;
+        for (std::size_t i = 0; i < n7; ++i) if (a7[i] != a4c[i]) ++d7;
+        printf("v7 vs v4: %zu of %zu elements differ\n", d7, n7);
+    }
+
+    // v8: v7's shape with the f16/f16 mma (2x the f32-accumulate rate). Not bit-identical, since a
+    // whole 128-element group accumulates in f16 before being promoted, so report the error
+    {
+        cudaEvent_t q0, q1; CK(cudaEventCreate(&q0)); CK(cudaEventCreate(&q1));
+        CK(cudaEventRecord(q0));
+        for (int i = 0; i < reps; ++i) {
+            launch_pq2_mma_v8(d_codes, reinterpret_cast<const std::uint8_t*>(d_scales), d_x, d_out, rows, groups, tokens, k, rows, 0);
+        }
+        CK(cudaEventRecord(q1)); CK(cudaEventSynchronize(q1));
+        float ms8 = 0.f; CK(cudaEventElapsedTime(&ms8, q0, q1)); ms8 /= reps;
+        printf("v8  %.3f ms   %.1f tok/s   %.1f TFLOPS\n", ms8, tokens / (ms8 / 1000.0), flop / (ms8 / 1000.0) / 1e12);
+        const std::size_t n8 = (std::size_t)tokens * rows;
+        std::vector<__nv_bfloat16> b8(n8), b4(n8);
+        CK(cudaMemcpy(b8.data(), d_out, n8 * sizeof(__nv_bfloat16), cudaMemcpyDeviceToHost));
+        CK(cudaMemcpy(b4.data(), d_ref, n8 * sizeof(__nv_bfloat16), cudaMemcpyDeviceToHost));
+        double nu = 0, de = 0, mx = 0; std::size_t d8 = 0;
+        for (std::size_t i = 0; i < n8; ++i) {
+            const double v8 = __bfloat162float(b8[i]), v4 = __bfloat162float(b4[i]);
+            const double dd = v8 - v4;
+            nu += dd * dd; de += v4 * v4;
+            if (fabs(dd) > mx) mx = fabs(dd);
+            if (b8[i] != b4[i]) ++d8;
+        }
+        printf("v8 vs v4: rel_l2 %.3e   max|diff| %.4f   %zu of %zu differ\n",
+               std::sqrt(nu / (de + 1e-30)), mx, d8, n8);
+    }
+
+    // v9: v8's shape with the tiles-per-warp knob (occupancy vs A/B reuse) and ldmatrix A loads
+    {
+        cudaEvent_t z0, z1; CK(cudaEventCreate(&z0)); CK(cudaEventCreate(&z1));
+        CK(cudaEventRecord(z0));
+#if kV9_PACKED
+        static __half* d_xp = nullptr;
+        const std::size_t t8 = ((std::size_t)(tokens + 7) / 8) * 8;
+        if (!d_xp) CK(cudaMalloc(&d_xp, t8 * (std::size_t)k * sizeof(__half)));
+        launch_pack_b(d_x, reinterpret_cast<__half*>(d_xp), tokens, k, k, 0);
+        CK(cudaDeviceSynchronize());
+#endif
+        for (int i = 0; i < reps; ++i) {
+#if kV9_PACKED
+            launch_pq2_mma_v9(d_codes, reinterpret_cast<const std::uint8_t*>(d_scales),
+                              reinterpret_cast<const __nv_bfloat16*>(d_xp), d_out, rows, groups, tokens, k, rows, 0);
+#else
+            launch_pq2_mma_v9(d_codes, reinterpret_cast<const std::uint8_t*>(d_scales), d_x, d_out, rows, groups, tokens, k, rows, 0);
+#endif
+        }
+        CK(cudaEventRecord(z1)); CK(cudaEventSynchronize(z1));
+        float ms9 = 0.f; CK(cudaEventElapsedTime(&ms9, z0, z1)); ms9 /= reps;
+        printf("v9  %.3f ms   %.1f tok/s   %.1f TFLOPS   [tiles=%d ldmatrix=%d minblocks=%d]\n", ms9,
+               tokens / (ms9 / 1000.0), flop / (ms9 / 1000.0) / 1e12,
+               kV9TilesPerWarp, kV9_LDMATRIX, kV9_MINBLOCKS);
+        const std::size_t n9 = (std::size_t)tokens * rows;
+        std::vector<__nv_bfloat16> b9(n9), b4y(n9);
+        CK(cudaMemcpy(b9.data(), d_out, n9 * sizeof(__nv_bfloat16), cudaMemcpyDeviceToHost));
+        CK(cudaMemcpy(b4y.data(), d_ref, n9 * sizeof(__nv_bfloat16), cudaMemcpyDeviceToHost));
+        double nu9 = 0, de9 = 0, mx9 = 0; std::size_t d9 = 0;
+        for (std::size_t i = 0; i < n9; ++i) {
+            const double v9v = __bfloat162float(b9[i]), v4v = __bfloat162float(b4y[i]);
